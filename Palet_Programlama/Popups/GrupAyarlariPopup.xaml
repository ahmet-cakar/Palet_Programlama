<Window x:Class="Palet_Programlama.Popuplar.GrupAyarlariPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Background="Transparent"
        Title="Grup Ayarları"
        Height="600"
        Width="900"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        >

  <Window.Resources>
    <SolidColorBrush x:Key="PopupOverlayBrush" Color="Transparent"/>

    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#1B1B1D"/>
    <SolidColorBrush x:Key="CardBrush" Color="#191919"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2A2B2F"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8E8E8E"/>

    <!-- Lacivertler kaldırıldı -->
    <SolidColorBrush x:Key="InputBrush" Color="#191919"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#343434"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#F4BE00"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFD24A"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#F4BE00"/>

    <!-- Lacivert yerine koyu gri -->
    <SolidColorBrush x:Key="PassiveButtonBrush" Color="#202225"/>
    <SolidColorBrush x:Key="PassiveButtonHoverBrush" Color="#2A2D31"/>
    <SolidColorBrush x:Key="PassiveButtonBorderBrush" Color="#3A3D42"/>

    <SolidColorBrush x:Key="CloseButtonBrush" Color="#1F2024"/>
    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="#2C2D32"/>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <Style x:Key="LabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="Background" Value="{StaticResource InputBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="YonSecimButtonStyle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Background" Value="{StaticResource PassiveButtonBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource PassiveButtonBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height" Value="58"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="14,10">
              <Grid>
                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PassiveButtonHoverBrush}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              </Trigger>

              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="#111214"/>
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="#111214"/>
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="22,12"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18">
              <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="Background" Value="{StaticResource PassiveButtonBrush}"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="22,12"/>
      <Setter Property="BorderBrush" Value="{StaticResource PassiveButtonBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
              <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PassiveButtonHoverBrush}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="Background" Value="{StaticResource CloseButtonBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CloseButtonHoverBrush}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Background="{StaticResource PopupOverlayBrush}">
    <Border Width="900"
                Padding="28"
                Background="{StaticResource PopupBackgroundBrush}"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" MouseLeftButtonDown="Grid_MouseLeftButtonDown">

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="20"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="24"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
          <TextBlock x:Name="TxtBaslik"
           Foreground="{StaticResource TextPrimaryBrush}"
           FontSize="28"
           FontWeight="Bold"
           VerticalAlignment="Center"/>
        </DockPanel>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="1.8*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="22">

            <StackPanel>
              <TextBlock Text="Bırakma Ayarları"
                                       Style="{StaticResource SectionTitleStyle}"/>

              <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Gripper açılma yönü"
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,0,0,10"/>

                <UniformGrid Columns="2" Rows="2">
                  <ToggleButton x:Name="TglBirakmaYonuEksiX"
                                                  Style="{StaticResource YonSecimButtonStyle}"
                                                  Content="- X"
                                                  IsChecked="True"
                                                  Margin="0,0,10,10"
                                                  Checked="BirakmaYonu_Checked"/>

                  <ToggleButton x:Name="TglBirakmaYonuEksiY"
                                                  Style="{StaticResource YonSecimButtonStyle}"
                                                  Content="- Y"
                                                  Margin="0,0,0,10"
                                                  Checked="BirakmaYonu_Checked"/>

                  <ToggleButton x:Name="TglBirakmaYonuArtiX"
                                                  Style="{StaticResource YonSecimButtonStyle}"
                                                  Content="+ X"
                                                  Margin="0,0,10,0"
                                                  Checked="BirakmaYonu_Checked"/>

                  <ToggleButton x:Name="TglBirakmaYonuArtiY"
                                                  Style="{StaticResource YonSecimButtonStyle}"
                                                  Content="+ Y"
                                                  Checked="BirakmaYonu_Checked"/>
                </UniformGrid>
              </StackPanel>

              <StackPanel>
                <TextBlock Text="Offset Değerleri "
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <TextBlock Grid.Column="0"
                                               Text="X"
                                               Style="{StaticResource LabelStyle}"
                                               VerticalAlignment="Center"/>

                  <TextBox Grid.Column="1"
                                             x:Name="TxtOffsetX"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             Text="0"/>
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <TextBlock Grid.Column="0"
                                               Text="Y"
                                               Style="{StaticResource LabelStyle}"
                                               VerticalAlignment="Center"/>

                  <TextBox Grid.Column="1"
                                             x:Name="TxtOffsetY"
                                             Style="{StaticResource InputTextBoxStyle}"
                                             Text="0"/>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="2"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="22">
            <StackPanel>
              <TextBlock Text="Gripper Yönü"
                                       Style="{StaticResource SectionTitleStyle}"/>

              <Border Height="250"
                                    Background="#18191C"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16">
                <Grid>
                  <TextBlock Text="Önizleme Alanı"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                </Grid>
              </Border>

              <TextBlock Margin="0,16,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="14"
                                       Text="Gripperın taşıyıcı kenarının açılacağı yönü gösterir."/>
            </StackPanel>
          </Border>
        </Grid>

        <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
          <Button Width="130"
                            Height="48"
                            Margin="0,0,12,0"
                            Content="İptal"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnIptal_Click"/>

          <Button Width="130"
                            Height="48"
                            Content="Kaydet"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnKaydet_Click"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>