<Window x:Class="Palet_Programlama.UserController.OnayKutusu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:language="clr-namespace:Palet_Programlama.Languages"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Height="270"
        Width="620"
        Background="Transparent">

  <Window.Resources>
    <language:LanguageConverter x:Key="LanguageConverter"/>
  </Window.Resources>

  <Grid>
    <Border Background="#191919"
                BorderBrush="#f59f05"
                BorderThickness="2"
                CornerRadius="15"
                Padding="18">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                           Text="{Binding Source='MesajKutusu.uyari',Converter={StaticResource LanguageConverter}}"
                           FontSize="27"
                           FontFamily="Roboto"
                           Margin="10,10,10,16"
                           Foreground="White"/>

        <TextBlock Grid.Row="1"
                           x:Name="mesaj"
                           TextWrapping="Wrap"
                           LineHeight="27"
                           FontSize="18"
                           Width="540"
                           Foreground="White"
                           Margin="10,0,10,10"
                           FontFamily="Roboto"
                           VerticalAlignment="Top"/>

        <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,18,0,6">
          <Button x:Name="btnEvet"
                            Width="150"
                            Height="42"
                            Margin="0,0,10,0"
                            Background="{StaticResource button_background_green}"
                            Style="{StaticResource button_template}"
                            Click="btnEvet_Click"/>

          <Button x:Name="btnHayir"
                            Width="150"
                            Height="42"
                            Background="{StaticResource button_background}"
                            Style="{StaticResource button_template}"
                            Click="btnHayir_Click"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>