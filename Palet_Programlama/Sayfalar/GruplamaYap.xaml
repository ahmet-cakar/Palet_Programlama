<Page x:Class="Palet_Programlama.Sayfalar.GruplamaYap"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Palet_Programlama.Sayfalar"
      xmlns:sınıflar="clr-namespace:Palet_Programlama.Sınıflar"
      mc:Ignorable="d" 
      
      d:DesignHeight="768" d:DesignWidth="1366"
      Title="GruplamaYap">
  <Page.Resources>
    <sınıflar:LanguageConverter  x:Key="LanguageConverter" />
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="7*"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <!-- Header item control başlangıç -->
    <Grid Grid.Row="0">
      <Border VerticalAlignment="Center">
        <local:UstMenu Margin="0,5,0,0"/>
      </Border>
    </Grid>
    <!-- Header item control bitiş -->

    <Grid Grid.Row="1">


      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>
        <!-- Ürün En-Boy alanı başlangıç -->
        <Border CornerRadius="15" Grid.Column="0" Margin="50,20,10,0"  Background="#191919">

          <Grid Margin="20,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="20"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
               VerticalAlignment="Center"
               Foreground="#F3F4F6"
               FontSize="26"
               FontWeight="SemiBold"
               Text="{Binding Source='GruplamaYap.txtPalet',Converter={StaticResource LanguageConverter}}"/>

            

            <TextBlock Grid.Column="2"
               x:Name="txtPaletOzellikleri"
               VerticalAlignment="Center"
               Foreground="White"
               FontSize="24"
               FontWeight="Normal"
               TextTrimming="CharacterEllipsis"
               TextWrapping="NoWrap"
               Text="EuroPalet - 280 mm X 300 mm X 600 mm"/>
          </Grid>




        </Border>
        <!-- Ürün En-Bot alanı bitiş -->

        <!-- Gruplandırma alanı başlangıç -->

        <Border Grid.Column="1" CornerRadius="15"  Margin="0,20,40,0"  Background="#191919">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" 
                                    Grid.Column="0">

              <TextBlock  VerticalAlignment="Center" 
                                    HorizontalAlignment="Center"
                          Foreground="White"
                          FontSize="28"
                          Text="{Binding Source='GruplamaYap.txtGruplandirma',Converter={StaticResource LanguageConverter}}"></TextBlock>
            </StackPanel>
            <StackPanel Margin="30,0,0,0" Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="BtnGruplandirmaEksi" Margin="0,0,80,0" Style="{StaticResource transparan_button}" Click="BtnGruplandirmaEksi_Click">
                <StackPanel>
                  <Image 
                                       MaxHeight="60"
                                       MaxWidth="60"
                                       Source="pack://application:,,,/Resimler/UserControlUstMenu/geri_icon.png"/>
                </StackPanel>
              </Button>
              <TextBlock x:Name="txtGrupValue"  VerticalAlignment="Center"
                                        Margin="0,0,80,0"
                                        TextAlignment="Center"
                                     Foreground="White"
                                     FontSize="34"
                                     Text="1" Width="57"/>
              <Button x:Name="BtnGruplandirmaArti" Style="{StaticResource transparan_button}" Click="BtnGruplandirmaArti_Click" >
                <StackPanel>
                  <Image 
                                MaxHeight="60"
                                MaxWidth="60"
                                Source="pack://application:,,,/Resimler/UserControlUstMenu/ileri_icon.png"/>
                </StackPanel>
              </Button>

            </StackPanel>
          </Grid>
        </Border>
        <!-- Gruplandırma  alanı bitiş -->

      </Grid>

    </Grid>


    <Grid Grid.Row="2">



      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="8*"/>
        <ColumnDefinition Width="7*"/>
        <ColumnDefinition Width="*"/>


      </Grid.ColumnDefinitions>


      <Border Margin="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Ürün / Dizilim / Program seçim alanı -->
          <Border Grid.Row="0"
                Margin="50,8,10,0"
                Padding="24,20"
                CornerRadius="18"
                Background="#191919"
                BorderBrush="#2B2B2B"
                BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Column="0"
                           Grid.Row="0"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Text="{Binding Source='GruplamaYap.txtUrunSecimi',Converter={StaticResource LanguageConverter}}"/>

              <ComboBox x:Name="CboxUrunListesi"
                          Grid.Column="2"
                          Grid.Row="0"
                          Height="50"
                          FontSize="20"
                          Style="{DynamicResource theComboBox}"
                          Background="#D4D4D4"
                          Foreground="#575757"
                          HorizontalContentAlignment="Left"
                          VerticalContentAlignment="Center"
                          Padding="8,0"
                          ItemContainerStyle="{DynamicResource theComboBoxItem}"
                          SelectionChanged="CboxUrunListesi_SelectionChanged"/>

              <TextBlock Grid.Column="0"
                           Grid.Row="2"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Text="{Binding Source='GruplamaYap.txtDizilimSecimi',Converter={StaticResource LanguageConverter}}"/>

              <ComboBox x:Name="CboxDizilimListesi"
                          Grid.Column="2"
                          Grid.Row="2"
                          Height="50"
                          FontSize="20"
                          Style="{DynamicResource theComboBox}"
                          Background="#D4D4D4"
                          Foreground="#575757"
                          HorizontalContentAlignment="Left"
                          VerticalContentAlignment="Center"
                          Padding="8,0"
                          ItemContainerStyle="{DynamicResource theComboBoxItem}"
                          SelectionChanged="CboxDizilimListesi_SelectionChanged"/>

              <TextBlock Grid.Column="0"
                           Grid.Row="4"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Text="Program Seçimi"/>

              <ComboBox x:Name="CboxProgramListesi"
                          Grid.Column="2"
                          Grid.Row="4"
                          Height="50"
                          FontSize="20"
                          Style="{DynamicResource theComboBox}"
                          Background="#D4D4D4"
                          Foreground="#575757"
                          HorizontalContentAlignment="Left"
                          VerticalContentAlignment="Center"
                          Padding="8,0"
                          ItemContainerStyle="{DynamicResource theComboBoxItem}" SelectionChanged="CboxProgramListesi_SelectionChanged"
                          />
            </Grid>
          </Border>

          <!-- Gruplama seçimi alanı -->
          <Border Grid.Row="2"
                Margin="50,0,10,10"
                Padding="18"
                CornerRadius="18"
                Background="#191919"
                BorderBrush="#2B2B2B"
                BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1*"/>
              </Grid.ColumnDefinitions>

              <!-- Sol taraf -->
              <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="14"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                               Margin="0,0,0,4"
                               Foreground="#F3F4F6"
                               HorizontalAlignment="Center"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Text="{Binding Source='GruplamaYap.txtGruplamaSecimi',Converter={StaticResource LanguageConverter}}"/>

                <ListBox x:Name="ListBoxGruplama"
                             Grid.Row="2"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="8,0,8,0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="ListBoxGruplama_SelectionChanged">

                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>

                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="Margin" Value="0,0,0,12"/>
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="Cursor" Value="Hand"/>
                      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ItemBorder"
                                                    Background="#222222"
                                                    BorderBrush="#303030"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="18,14">
                              <ContentPresenter HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3A3A3A"/>
                              </Trigger>

                              <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#4B5563"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#9CA3AF"/>
                              </Trigger>

                              <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.6"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListBox.ItemContainerStyle>

                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                          <TextBlock Foreground="#E5E7EB"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Source='GruplamaYap.txtKatNo', Converter={StaticResource LanguageConverter}}"/>

                          <TextBlock Margin="6,0,0,0"
                                                   Foreground="White"
                                                   FontSize="19"
                                                   FontWeight="Bold"
                                                   Text="{Binding KatNo}"/>

                          <Border Width="1"
                                                Height="22"
                                                Margin="16,2"
                                                Background="#4B5563"/>

                          <TextBlock Foreground="#E5E7EB"
                                                   FontSize="19"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Source='GruplamaYap.txtGrupNo', Converter={StaticResource LanguageConverter}}"/>

                          <TextBlock Margin="6,0,0,0"
                                                   Foreground="White"
                                                   FontSize="19"
                                                   FontWeight="Bold"
                                                   Text="{Binding GrupNo}"/>
                        </StackPanel>

                        <CheckBox Grid.Column="1"
                                              Margin="20,0,0,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Right"
                                              IsEnabled="False"
                                              IsChecked="{Binding IsaretliMi}">
                          <CheckBox.Style>
                            <Style TargetType="CheckBox">
                              <Setter Property="Template">
                                <Setter.Value>
                                  <ControlTemplate TargetType="CheckBox">
                                    <Border Width="34"
                                                                    Height="34"
                                                                    CornerRadius="8"
                                                                    Background="#2A2A2A"
                                                                    BorderBrush="#4B5563"
                                                                    BorderThickness="1">
                                      <TextBlock x:Name="DurumIcon"
                                                                           Text="✖"
                                                                           Foreground="#EF4444"
                                                                           FontSize="18"
                                                                           FontWeight="Bold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                      <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="DurumIcon" Property="Text" Value="✔"/>
                                        <Setter TargetName="DurumIcon" Property="Foreground" Value="#22C55E"/>
                                      </Trigger>
                                    </ControlTemplate.Triggers>
                                  </ControlTemplate>
                                </Setter.Value>
                              </Setter>
                            </Style>
                          </CheckBox.Style>
                        </CheckBox>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>

              <!-- Sağ taraf butonlar -->
              <StackPanel Grid.Column="2"
                            VerticalAlignment="Bottom"
                            Margin="0,8,0,0">
                <Button x:Name="BtnGrupAyarlar"
                            FontSize="22"
                            Height="54"
                            Width="200"
                            Margin="0,0,0,14"
                            HorizontalAlignment="Stretch"
                            Content="{Binding Source='GruplamaYap.btnAyarlar',Converter={StaticResource LanguageConverter}}"
                            Background="{StaticResource button_background}"
                            Style="{StaticResource button_template}"
                            Click="BtnGrupAyarlar_Click"/>

                <!--<Button FontSize="22"
                            Height="54"
                            Margin="0,0,0,14"
                            HorizontalAlignment="Stretch"
                            Content="{Binding Source='GruplamaYap.btnAyir',Converter={StaticResource LanguageConverter}}"
                            Background="{StaticResource button_background}"
                            Style="{StaticResource button_template}"/>

                <Button FontSize="22"
                            Height="54"
                            HorizontalAlignment="Stretch"
                            Content="{Binding Source='GruplamaYap.btnBirlestir',Converter={StaticResource LanguageConverter}}"
                            Background="{StaticResource button_background}"
                            Style="{StaticResource button_template}"/>-->
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>
      <!--Urun dizme alanı başlangıç-->
      <Border CornerRadius="20" Margin="5,10,35,10"  Grid.Column="1"   Background="#191919">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6*"/>

          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8*"/>

          </Grid.ColumnDefinitions>
          <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2" >
            <StackPanel HorizontalAlignment="Left"  >
              <Image  Margin="40,25,0,0"
                           MaxHeight="250"
                           MaxWidth="250"
                           Source="pack://application:,,,/Resimler/DizilimYap/referans_eksenler.png"/>
            </StackPanel>
          </Grid>

          <Border Grid.Column="1" Grid.Row="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"  >

              <Canvas Name="canvasPalet"
                                Width="600"
                                Height="400"
                                >
                <Canvas.Background>
                  <ImageBrush ImageSource="pack://application:,,,/Resimler/DizilimYap/palet.png"/>
                </Canvas.Background>
              </Canvas>

            </StackPanel>
          </Border>

        </Grid>
      </Border>
      <!--Urun dizme alanı başlangıç-->

      <!--Kat arttırma azaltma alanı başlangıç-->
      <Border CornerRadius="20" Margin="-20,10,40,10" Background="#191919"  Grid.Column="2">
        <Grid Margin="0,40,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="*"/>

          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">

            <TextBlock Margin="0,50,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Foreground="White"
                      FontSize="30"
                      Text="{Binding Source='DizilimYap.txtKat',Converter={StaticResource LanguageConverter}}"></TextBlock>
          </StackPanel>

          <StackPanel Grid.Row="1" Orientation="Vertical">
            <Button x:Name="BtnKatArti" Margin="0,80,0,0" Style="{StaticResource transparan_button}"  Click="BtnKatArti_Click">
              <StackPanel>
                <Image 
                               MaxHeight="50"
                               MaxWidth="50"
                               Source="pack://application:,,,/Resimler/DizilimYap/yukari_icon.png"/>
              </StackPanel>
            </Button>
            <TextBlock x:Name="txtKatValue" TextAlignment="Center" Margin="0,20,0,0" HorizontalAlignment="Center"
                     Foreground="White"
                     FontSize="30"
                     Text="1" Width="46"/>
            <Button x:Name="BtnKatEksi" Margin="0,20,0,0" Style="{StaticResource transparan_button}" Click="BtnKatEksi_Click" >
              <StackPanel>
                <Image 
                        MaxHeight="50"
                        MaxWidth="50"
                        Source="pack://application:,,,/Resimler/DizilimYap/asagi_icon.png"/>
              </StackPanel>
            </Button>

          </StackPanel>
        </Grid>
      </Border>
      <!--Kat arttırma azaltma alanı bitiş-->
    </Grid>

    <!--Alt buttonlar Footer başlangıç-->
    <Grid Grid.Row="3" >
      <Border CornerRadius="20"  Margin="50,0,300,10" Background="Transparent">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="BtnProgramKaydet" FontSize="24"  Content="{Binding Source='GruplamaYap.btnKaydet',Converter={StaticResource LanguageConverter}}" Width="240" 
                             Background="{StaticResource button_background_green}" Style="{StaticResource button_template}" Click="BtnProgramKaydet_Click" />
          <Button FontSize="24" x:Name="BtnGruplariTemizle"   Content="{Binding Source='GruplamaYap.btnGruplariTemizle',Converter={StaticResource LanguageConverter}}" Width="240"  Margin="10,0,0,0"
         Background="{StaticResource button_background}" Style="{StaticResource button_template}" Click="BtnGruplariTemizle_Click" />
          <!--<Button FontSize="24"   Content="{Binding Source='GruplamaYap.btnDizilimListesi',Converter={StaticResource LanguageConverter}}" Width="240" Margin="10,0,0,0"
         Background="{StaticResource button_background}" Style="{StaticResource button_template}" />-->
        </StackPanel>
      </Border>
    </Grid>
    <!--Alt buttonlar Footer bitiş-->

  </Grid>
</Page>
