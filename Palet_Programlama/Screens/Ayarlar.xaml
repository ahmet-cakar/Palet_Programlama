<Page x:Class="Palet_Programlama.Screens.Ayarlar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Palet_Programlama.Screens"
      xmlns:controls="clr-namespace:Palet_Programlama.UserController"
      xmlns:language="clr-namespace:Palet_Programlama.Languages"
      mc:Ignorable="d" 
      d:DesignHeight="868" d:DesignWidth="1809"
      Title="Ayarlar">

  <Page.Resources>
    <language:LanguageConverter x:Key="LanguageConverter"/>

    <Style x:Key="AyarMenuListBoxStyle" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="AyarMenuItemStyle" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd"
                                Background="#222222"
                                CornerRadius="12"
                                Padding="16,14"
                                SnapsToDevicePixels="True">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2E2E2E"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AyarBaslikStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="AyarAciklamaStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#D4D4D4"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Page.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Border VerticalAlignment="Center">
        <controls:UstMenu x:Name="UstMenuControl" Margin="0,5,0,0"/>
      </Border>
    </Grid>

    <!-- Üst bilgi kartı -->
    <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="18,14"
                CornerRadius="15"
                Background="#191919">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                           Text="Ayarlar"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Margin="0,0,18,0"/>

        <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Foreground="#D4D4D4"
                           FontSize="18"
                           Text="Sistem yapılandırma, kullanıcı ve uygulama ayarlarını buradan yönetebilirsiniz."
                           TextWrapping="Wrap"/>
      </Grid>
    </Border>

    <!-- Ana alan -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Sol menü -->
      <Border Grid.Column="0"
                    Background="#191919"
                    CornerRadius="15"
                    Padding="18">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                               Text="Ayar Menüsü"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

          <ListBox Grid.Row="1"
                             x:Name="lstAyarMenusu"
                             Style="{StaticResource AyarMenuListBoxStyle}"
                             ItemContainerStyle="{StaticResource AyarMenuItemStyle}"
                             SelectedIndex="0">
            <ListBoxItem Content="Kullanıcı Yönetimi"/>
            <ListBoxItem Content="Dil Ayarları"/>
            <ListBoxItem Content="Yetki Ayarı"/>
            <ListBoxItem Content="Yedekleme / Geri Yükleme"/>
            <ListBoxItem Content="Varsayılan Sistem Ayarları"/>
          </ListBox>
        </Grid>
      </Border>

      <!-- Sağ içerik -->
      <Border Grid.Column="2"
                    Background="#191919"
                    CornerRadius="15"
                    Padding="22">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Başlık -->
          <TextBlock Grid.Row="0"
                               Text="Kullanıcı Yönetimi"
                               Style="{StaticResource AyarBaslikStyle}"/>

          <!-- Açıklama -->
          <TextBlock Grid.Row="2"
                               Style="{StaticResource AyarAciklamaStyle}"
                               Text="Bu bölümde kullanıcı ekleme, güncelleme, şifre değiştirme ve kullanıcı listesi işlemleri yer alacaktır."/>

          <!-- İçerik kartları -->
          <Grid Grid.Row="4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="12"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="12"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                                Background="#222222"
                                CornerRadius="12"
                                Padding="18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                  <TextBlock Text="Kullanıcı Adı"
                                               Foreground="White"
                                               FontSize="18"
                                               Margin="0,0,0,8"/>
                  <TextBox Height="42"
                                             FontSize="18"
                                             Background="#2B2B2B"
                                             Foreground="White"
                                             BorderBrush="#3C3C3C"
                                             BorderThickness="1"
                                             Padding="10,6"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                  <TextBlock Text="Şifre"
                                               Foreground="White"
                                               FontSize="18"
                                               Margin="0,0,0,8"/>
                  <PasswordBox Height="42"
                                                 FontSize="18"
                                                 Background="#2B2B2B"
                                                 Foreground="White"
                                                 BorderBrush="#3C3C3C"
                                                 BorderThickness="1"
                                                 Padding="10,6"/>
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Row="2"
                                Background="#222222"
                                CornerRadius="12"
                                Padding="18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                                           Text="Mevcut kullanıcılar burada listelenecek."
                                           Foreground="#D4D4D4"
                                           FontSize="18"
                                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                                        Content="Ekle"
                                        Width="120"
                                        Height="42"
                                        Margin="12,0,0,0"
                                        Background="{StaticResource button_background}"
                                        Style="{StaticResource button_template}"/>

                <Button Grid.Column="2"
                                        Content="Güncelle"
                                        Width="120"
                                        Height="42"
                                        Margin="12,0,0,0"
                                        Background="{StaticResource button_background}"
                                        Style="{StaticResource button_template}"/>

                <Button Grid.Column="3"
                                        Content="Sil"
                                        Width="120"
                                        Height="42"
                                        Margin="12,0,0,0"
                                        Background="{StaticResource button_background}"
                                        Style="{StaticResource button_template}"/>
              </Grid>
            </Border>

            <Border Grid.Row="4"
                                Background="#222222"
                                CornerRadius="12"
                                Padding="18">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="12"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                                           Text="Liste Alanı"
                                           Foreground="White"
                                           FontSize="20"
                                           FontWeight="SemiBold"/>

                <ListBox Grid.Row="2"
                                         Background="#2B2B2B"
                                         BorderThickness="0"
                                         Foreground="White"
                                         FontSize="18">
                  <ListBoxItem Content="admin"/>
                  <ListBoxItem Content="operator1"/>
                  <ListBoxItem Content="servis1"/>
                </ListBox>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>