<Page x:Class="Palet_Programlama.Screens.Ayarlar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Palet_Programlama.Screens"
      xmlns:controls="clr-namespace:Palet_Programlama.UserController"
      xmlns:language="clr-namespace:Palet_Programlama.Languages"
      mc:Ignorable="d" 
      d:DesignHeight="868" d:DesignWidth="1809"
      Title="Ayarlar">

  <Page.Resources>
    <language:LanguageConverter x:Key="LanguageConverter"/>

    <Style x:Key="AyarMenuListBoxStyle" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="AyarMenuItemStyle" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd"
                                Background="#222222"
                                CornerRadius="12"
                                Padding="16,14">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2E2E2E"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AyarBaslikStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="AyarAciklamaStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#D4D4D4"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Page.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Border VerticalAlignment="Center">
        <controls:UstMenu x:Name="UstMenuControl" Margin="0,5,0,0"/>
      </Border>
    </Grid>

    <!-- Ana Alan -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Sol Menü -->
      <Border Grid.Column="0"
                    Background="#191919"
                    CornerRadius="15"
                    Padding="18">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                               Text="Ayar Menüsü"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

          <ListBox Grid.Row="1"
                             x:Name="lstAyarMenusu"
                             Style="{StaticResource AyarMenuListBoxStyle}"
                             ItemContainerStyle="{StaticResource AyarMenuItemStyle}"
                             SelectedIndex="0">
            <ListBoxItem Content="Kullanıcı Yönetimi"/>
            <!--<ListBoxItem Content="Dil Ayarları"/>-->
            <ListBoxItem Content="Yetki Ayarı"/>
            <ListBoxItem Content="Varsayılan Sistem Ayarları"/>
            <ListBoxItem Content="Yedekleme / Geri Yükleme"/>
          </ListBox>
        </Grid>
      </Border>

      <!-- Sağ İçerik -->
      <Border Grid.Column="2"
                    Background="#191919"
                    CornerRadius="15"
                    Padding="22">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                               Text="Kullanıcı Yönetimi"
                               Style="{StaticResource AyarBaslikStyle}"/>

          <TextBlock Grid.Row="2"
                               Style="{StaticResource AyarAciklamaStyle}"
                               Text="Bu bölümde kullanıcı ekleme, güncelleme ve şifre işlemleri yer alacaktır."/>

          <Grid Grid.Row="4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="12"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="12"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                                Background="#222222"
                                CornerRadius="12"
                                Padding="18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                  <TextBlock Text="Kullanıcı Adı"
                                               Foreground="White"
                                               FontSize="18"
                                               Margin="0,0,0,8"/>
                  <TextBox Height="42" Name="txtKullaniciAdi"
                                             FontSize="18"
                                             Background="#2B2B2B"
                                             Foreground="White"
                                             BorderBrush="#3C3C3C"
                                             BorderThickness="1"
                                             Padding="10,6"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                  <TextBlock Text="Şifre"
                                               Foreground="White"
                                               FontSize="18"
                                               Margin="0,0,0,8"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox x:Name="txtKullaniciSifre"
                 Grid.Column="0"
                 Height="42"
                 FontSize="18"
                 Background="#2B2B2B"
                 Foreground="White"
                 BorderBrush="#3C3C3C"
                 BorderThickness="1"
                 Padding="10,6"
                 VerticalContentAlignment="Center"/>

                    <TextBox x:Name="txtKullaniciSifreAcik"
             Grid.Column="0"
             Height="42"
             FontSize="18"
             Background="#2B2B2B"
             Foreground="White"
             BorderBrush="#3C3C3C"
             BorderThickness="1"
             Padding="10,6"
             VerticalContentAlignment="Center"
             Visibility="Collapsed"/>
             <Button x:Name="btnSifreGoster"
              Grid.Column="1"
              Margin="8,0,0,0"
              Content="👁"
              FontSize="18"
              Background="#3A3A3A"
              Foreground="White"
              BorderBrush="#4A4A4A"
              BorderThickness="1"
              Click="btnSifreGoster_Click"> 
                      <Button.Style>
                        <Style TargetType="Button">
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                                  <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Border>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </Button.Style>
                    </Button>

                  </Grid>
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Row="2"
                                Background="#222222"
                                CornerRadius="12"
                                Padding="18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                                           Text="Mevcut kullanıcılar burada listelenecek."
                                           Foreground="#D4D4D4"
                                           FontSize="18"
                                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                 x:Name="btnKullaniciEkle"
                                        Content="Ekle"
                                        Width="120"
                                        Height="42"
                                        Margin="12,0,0,0"
                                        Background="{StaticResource button_background}"
                                        Style="{StaticResource button_template}" HorizontalAlignment="Left" VerticalAlignment="Top" Click="btnKullaniciEkle_Click"/>

                <Button Grid.Column="2" x:Name="btnKullaniciGuncelle"
                                        Content="Güncelle"
                                        Width="120"
                                        Height="42"
                                        Margin="12,0,0,0"
                                        Background="{StaticResource button_background}"
                                        Style="{StaticResource button_template}" Click="btnKullaniciGuncelle_Click"/>

                <Button Grid.Column="3" x:Name="btnKullaniciSil"
                                        Content="Sil"
                                        Width="120"
                                        Height="42"
                                        Margin="12,0,0,0"
                                        Background="{StaticResource button_background}"
                                        Style="{StaticResource button_template}" Click="btnKullaniciSil_Click"/>
              </Grid>
            </Border>

            <Border Grid.Row="4"
        Background="#222222"
        CornerRadius="12"
        Padding="18">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="12"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False">
                  <TextBlock Text="Kullanıcı Listesi"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

                  <Border DockPanel.Dock="Right"
                    Background="#2E2E2E"
                    CornerRadius="10"
                    Padding="10,4"
                    Margin="12,0,0,0">
                    <TextBlock x:Name="txtKayiSayisi" 
                           Foreground="#D4D4D4"
                           FontSize="14"
                           FontWeight="SemiBold"/>
                  </Border>
                </DockPanel>

                <Border Grid.Row="2"
        Background="#2B2B2B"
        CornerRadius="10"
        Padding="10">
                  <ListBox x:Name="lstKullaniciListesi"
             Background="Transparent"
             BorderThickness="0"
             Foreground="White"
             FontSize="17"
             SelectionChanged="lstKullaniciListesi_SelectionChanged"
             ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,10"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                              <Border x:Name="ItemBorder"
                                    Background="#353535"
                                    CornerRadius="10"
                                    Padding="14,12">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                  </Grid.ColumnDefinitions>

                                  <Border Grid.Column="0"
                                            Width="34"
                                            Height="34"
                                            CornerRadius="17"
                                            Background="#454545"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="👤"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                  </Border>

                                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding KullaniciAdi}"
                                                   Foreground="White"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Rol}"
                                                   Foreground="#BDBDBD"
                                                   FontSize="13"/>
                                  </StackPanel>

                                  <Border Grid.Column="3"
                                            CornerRadius="8"
                                            Padding="10,4"
                                            VerticalAlignment="Center">
                                    <Border.Style>
                                      <Style TargetType="Border">
                                        <Setter Property="Background" Value="#7A2E2E"/>
                                        <Style.Triggers>
                                          <DataTrigger Binding="{Binding AktifMi}" Value="True">
                                            <Setter Property="Background" Value="#2E7D32"/>
                                          </DataTrigger>
                                        </Style.Triggers>
                                      </Style>
                                    </Border.Style>

                                    <TextBlock Foreground="White"
                                                   FontSize="12"
                                                   FontWeight="SemiBold">
                                      <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                          <Setter Property="Text" Value="Pasif"/>
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding AktifMi}" Value="True">
                                              <Setter Property="Text" Value="Aktif"/>
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </TextBlock.Style>
                                    </TextBlock>
                                  </Border>
                                </Grid>
                              </Border>

                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="ItemBorder" Property="Background" Value="#404040"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                  <Setter TargetName="ItemBorder" Property="Background" Value="#4A4A4A"/>
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ListBox.ItemContainerStyle>
                  </ListBox>
                </Border>
              </Grid>
            </Border>
          </Grid>
       
       
       </Grid>
      </Border>
    </Grid>

    <!-- Alt Kaydet Butonu -->
    <Grid Grid.Row="2" Margin="30,30,0,0">
      <Button x:Name="btnTumAyarlariKaydet"
                    Content="Kaydet"
                    Width="180"
                    Height="48"
                    HorizontalAlignment="Left"
                    Background="{StaticResource button_background_green}"
                    Style="{StaticResource button_template}"/>
    </Grid>
  </Grid>
</Page>