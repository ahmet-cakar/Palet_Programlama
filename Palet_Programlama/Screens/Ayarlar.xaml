<Page x:Class="Palet_Programlama.Screens.Ayarlar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:controls="clr-namespace:Palet_Programlama.UserController"
      xmlns:language="clr-namespace:Palet_Programlama.Languages"
      mc:Ignorable="d"
      d:DesignWidth="1920"
      d:DesignHeight="1080"
      Title="Ayarlar">

  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Screens/GenelAyarlar/Styles/AyarlarStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <language:LanguageConverter x:Key="LanguageConverter"/>
    </ResourceDictionary>
  </Page.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Border VerticalAlignment="Center">
        <controls:UstMenu x:Name="UstMenuControl" Margin="0,5,0,0"/>
      </Border>
    </Grid>

    <!-- Ana Alan -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Sol Menü -->
      <Border Grid.Column="0" Margin="0,0,0,55"
                    Background="#191919"
                    CornerRadius="18"
                    Padding="24">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                               Text="Ayar Menüsü"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="SemiBold"
                               Margin="0,0,0,20"/>

          <ListBox Grid.Row="1"
                             x:Name="lstAyarMenusu"
                             SelectionChanged="lstAyarMenusu_SelectionChanged"
                             Style="{StaticResource AyarMenuListBoxStyle}"
                             ItemContainerStyle="{StaticResource AyarMenuItemStyle}">
            <ListBoxItem Content="Kullanıcı Yönetimi"/>
            <ListBoxItem Content="Yetki Ayarı"/>
            <ListBoxItem Content="Varsayılan Sistem Ayarları"/>
            <ListBoxItem Content="Geri Yükleme"/>
          </ListBox>
        </Grid>
      </Border>

      <!-- Sağ İçerik -->
      <Border Grid.Column="2" Margin="0,0,0,55"
                    Background="#191919"
                    CornerRadius="18"
                    Padding="28">

        <Grid>
          <!-- KULLANICI YÖNETİMİ PANELİ -->
          <Grid x:Name="panelKullaniciYonetimi" Visibility="Visible">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="16"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="14"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                                   Text="Kullanıcı Yönetimi"
                                   Style="{StaticResource AyarBaslikStyle}"/>

            <Grid Grid.Row="4">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- Form Alanı -->
              <Border Grid.Row="0"
                                    Background="#222222"
                                    CornerRadius="12"
                                    Padding="18">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="20"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="18"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Kullanıcı Adı -->
                    <StackPanel Grid.Row="0" Grid.Column="0">
                      <TextBlock Text="Kullanıcı Adı"
                                                       Foreground="White"
                                                       FontSize="18"
                                                       Margin="0,0,0,8"/>
                      <TextBox x:Name="txtKullaniciAdi"
                                                     Height="42"
                                                     FontSize="18"
                                                     MaxLength="40"
                                                     Background="#2B2B2B"
                                                     Foreground="White"
                                                     BorderBrush="#3C3C3C"
                                                     BorderThickness="1"
                                                     Padding="10,6"/>
                    </StackPanel>

                    <!-- Şifre -->
                    <StackPanel Grid.Row="0" Grid.Column="2">
                      <TextBlock Text="Şifre"
                                                       Foreground="White"
                                                       FontSize="18"
                                                       Margin="0,0,0,8"/>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>

                        <PasswordBox x:Name="txtKullaniciSifre"
                                                             Grid.Column="0"
                                                             Height="42"
                                                             FontSize="18"
                                                             Background="#2B2B2B"
                                                             Foreground="White"
                                                             BorderBrush="#3C3C3C"
                                                             BorderThickness="1"
                                                             Padding="10,6"
                                                             VerticalContentAlignment="Center"/>

                        <TextBox x:Name="txtKullaniciSifreAcik"
                                                         Grid.Column="0"
                                                         Height="42"
                                                         FontSize="18"
                                                         Background="#2B2B2B"
                                                         Foreground="White"
                                                         BorderBrush="#3C3C3C"
                                                         BorderThickness="1"
                                                         Padding="10,6"
                                                         VerticalContentAlignment="Center"
                                                         Visibility="Collapsed"/>

                        <Button x:Name="btnSifreGoster"
                                                        Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        Content="👁"
                                                        FontSize="18"
                                                        Background="#3A3A3A"
                                                        Foreground="White"
                                                        BorderBrush="#4A4A4A"
                                                        BorderThickness="1"
                                                        Click="btnSifreGoster_Click">
                          <Button.Style>
                            <Style TargetType="Button">
                              <Setter Property="Template">
                                <Setter.Value>
                                  <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                CornerRadius="8">
                                      <ContentPresenter HorizontalAlignment="Center"
                                                                                              VerticalAlignment="Center"/>
                                    </Border>
                                  </ControlTemplate>
                                </Setter.Value>
                              </Setter>
                            </Style>
                          </Button.Style>
                        </Button>
                      </Grid>
                    </StackPanel>

                    <!-- Rol -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                      <TextBlock Text="Rol"
                                                       Foreground="White"
                                                       FontSize="18"
                                                       Margin="0,0,0,8"/>
                      <ComboBox x:Name="cmbRolSecimi"
                                                      Height="42"
                                                      Style="{StaticResource KoyuTemaComboBoxStyle}"
                                                      ItemContainerStyle="{StaticResource KoyuTemaComboBoxItemStyle}"
                                                      SelectedIndex="0">
                        <ComboBoxItem Content="Seçim Yapılmadı"/>
                        <ComboBoxItem Content="Operator"/>
                        <ComboBoxItem Content="Admin"/>
                      </ComboBox>
                    </StackPanel>
                  </Grid>

                  <Border Grid.Row="2"
                                            Background="#2B2B2B"
                                            CornerRadius="10"
                                            Padding="12,10">
                    <TextBlock Text="Admin tüm sayfalara erişebilir, Operator sadece verilen yetkilerle çalışır."
                                                   Foreground="#D4D4D4"
                                                   FontSize="14"
                                                   TextWrapping="Wrap"/>
                  </Border>
                </Grid>
              </Border>

              <!-- Buton Alanı -->
              <Border Grid.Row="2"
                                    Background="#222222"
                                    CornerRadius="12"
                                    Padding="18">
                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left">

                  <Button x:Name="btnKullaniciEkle"
                                            Content="Ekle"
                                            Width="120"
                                            Height="42"
                                            Margin="0,0,12,0"
                                            Background="{StaticResource button_background}"
                                            Style="{StaticResource button_template}"
                                            Click="btnKullaniciEkle_Click"/>

                  <Button x:Name="btnKullaniciGuncelle"
                                            Content="Güncelle"
                                            Width="120"
                                            Height="42"
                                            Margin="0,0,12,0"
                                            Background="{StaticResource button_background}"
                                            Style="{StaticResource button_template}"
                                            Click="btnKullaniciGuncelle_Click"/>

                  <Button x:Name="btnKullaniciSil"
                                            Content="Sil"
                                            Width="120"
                                            Height="42"
                                            Margin="0"
                                            Background="{StaticResource button_background}"
                                            Style="{StaticResource button_template}"
                                            Click="btnKullaniciSil_Click"/>
                </StackPanel>
              </Border>

              <!-- Kullanıcı Listesi -->
              <Border Grid.Row="4"
                                    Background="#222222"
                                    CornerRadius="12"
                                    Padding="18">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>

                  <DockPanel Grid.Row="0" LastChildFill="False">
                    <TextBlock Text="Kullanıcı Listesi"
                                                   Foreground="White"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>

                    <Border DockPanel.Dock="Right"
                                                Background="#2E2E2E"
                                                CornerRadius="10"
                                                Padding="10,4"
                                                Margin="12,0,0,0">
                      <TextBlock x:Name="txtKayiSayisi"
                                                       Foreground="#D4D4D4"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"/>
                    </Border>
                  </DockPanel>

                  <Border Grid.Row="2"
                                            Background="#2B2B2B"
                                            CornerRadius="10"
                                            Padding="10">
                    <ListBox x:Name="lstKullaniciListesi"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="White"
                                                 FontSize="17"
                                                 SelectionChanged="lstKullaniciListesi_SelectionChanged"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                      <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                          <Setter Property="Padding" Value="0"/>
                          <Setter Property="Margin" Value="0,0,0,10"/>
                          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="ItemBorder"
                                                                        Background="#353535"
                                                                        CornerRadius="10"
                                                                        Padding="14,12">
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="Auto"/>
                                      <ColumnDefinition Width="12"/>
                                      <ColumnDefinition Width="*"/>
                                      <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                                                                Width="34"
                                                                                Height="34"
                                                                                CornerRadius="17"
                                                                                Background="#454545"
                                                                                VerticalAlignment="Center">
                                      <TextBlock Text="👤"
                                                                                       FontSize="16"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                      <TextBlock Text="{Binding KullaniciAdi}"
                                                                                       Foreground="White"
                                                                                       FontSize="17"
                                                                                       FontWeight="SemiBold"/>
                                      <TextBlock Text="{Binding Rol}"
                                                                                       Foreground="#BDBDBD"
                                                                                       FontSize="13"/>
                                    </StackPanel>

                                    <Border Grid.Column="3"
                                                                                CornerRadius="8"
                                                                                Padding="10,4"
                                                                                VerticalAlignment="Center">
                                      <Border.Style>
                                        <Style TargetType="Border">
                                          <Setter Property="Background" Value="#7A2E2E"/>
                                        </Style>
                                      </Border.Style>

                                      <TextBlock Foreground="White"
                                                                                       FontSize="12"
                                                                                       FontWeight="SemiBold">
                                        <TextBlock.Style>
                                          <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Pasif"/>
                                            <Style.Triggers>
                                              <DataTrigger Binding="{Binding AktifMi}" Value="True">
                                                <Setter Property="Text" Value="Aktif"/>
                                              </DataTrigger>
                                            </Style.Triggers>
                                          </Style>
                                        </TextBlock.Style>
                                      </TextBlock>
                                    </Border>
                                  </Grid>
                                </Border>

                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#404040"/>
                                  </Trigger>
                                  <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#4A4A4A"/>
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </ListBox.ItemContainerStyle>
                    </ListBox>
                  </Border>
                </Grid>
              </Border>
            </Grid>
          </Grid>

          <!-- YETKİ AYARI PANELİ -->
          <Grid x:Name="panelYetkiAyari" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="16"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                                   Text="Yetki Ayarı"
                                   Style="{StaticResource AyarBaslikStyle}"/>

            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- Kullanıcı listesi -->
              <Border Grid.Column="0"
                                    Background="#222222"
                                    CornerRadius="12"
                                    Padding="18">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>

                  <TextBlock Text="Kullanıcılar"
                                               Foreground="White"
                                               FontSize="22"
                                               FontWeight="SemiBold"/>

                  <ListBox Grid.Row="2"
                                             x:Name="lstYetkiKullaniciListesi"
                                             Background="#2B2B2B"
                                             BorderThickness="0"
                                             Foreground="White"
                                             FontSize="17"
                                             SelectionChanged="lstYetkiKullaniciListesi_SelectionChanged">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="8">
                          <TextBlock Text="{Binding KullaniciAdi}"
                                                               Foreground="White"
                                                               FontSize="17"
                                                               FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding Rol}"
                                                               Foreground="#BDBDBD"
                                                               FontSize="13"/>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>

              <!-- Sayfa yetkileri -->
              <Border Grid.Column="2"
                                    Background="#222222"
                                    CornerRadius="12"
                                    Padding="18">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <TextBlock Text="Sayfa Yetkileri"
                                               Foreground="White"
                                               FontSize="22"
                                               FontWeight="SemiBold"/>

                  <TextBlock Grid.Row="2"
                                               x:Name="txtSeciliYetkiKullanici"
                                               Text="Kullanıcı seçiniz"
                                               Foreground="#D4D4D4"
                                               FontSize="16"/>

                  <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="16"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="12"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="12"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="12"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Background="#2B2B2B" CornerRadius="10" Padding="14">
                      <CheckBox x:Name="chkUrunEkle"
                                                      Content="Ürün/Palet Ekle"
                                                      Style="{StaticResource SagdaKutuluCheckBoxStyle}"/>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2" Background="#2B2B2B" CornerRadius="10" Padding="14">
                      <CheckBox x:Name="chkDizilimYap"
                                                      Content="Dizilim Oluştur"
                                                      Style="{StaticResource SagdaKutuluCheckBoxStyle}"/>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" Background="#2B2B2B" CornerRadius="10" Padding="14">
                      <CheckBox x:Name="chkGruplamaYap"
                                                      Content="Gruplama Oluştur"
                                                      Style="{StaticResource SagdaKutuluCheckBoxStyle}"/>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="2" Background="#2B2B2B" CornerRadius="10" Padding="14">
                      <CheckBox x:Name="chkProgramlar"
                                                      Content="Programlar"
                                                      Style="{StaticResource SagdaKutuluCheckBoxStyle}"/>
                    </Border>

                    <Border Grid.Row="4" Grid.Column="0" Background="#2B2B2B" CornerRadius="10" Padding="14">
                      <CheckBox x:Name="chkHizAyarlari"
                                                      Content="Hız Ayarları"
                                                      Style="{StaticResource SagdaKutuluCheckBoxStyle}"/>
                    </Border>

                    <Border Grid.Row="4" Grid.Column="2" Background="#2B2B2B" CornerRadius="10" Padding="14">
                      <CheckBox x:Name="chkAlarmlar"
                                                      Content="Alarmlar"
                                                      Style="{StaticResource SagdaKutuluCheckBoxStyle}"/>
                    </Border>

                    <Border Grid.Row="6" Grid.Column="0" Background="#2B2B2B" CornerRadius="10" Padding="14">
                      <CheckBox x:Name="chkIzleme"
                                                      Content="İzleme"
                                                      Style="{StaticResource SagdaKutuluCheckBoxStyle}"/>
                    </Border>

                    <Border Grid.Row="6" Grid.Column="2" Background="#2B2B2B" CornerRadius="10" Padding="14">
                      <CheckBox x:Name="chkAyarlar"
                                                      Content="Ayarlar"
                                                      Style="{StaticResource SagdaKutuluCheckBoxStyle}"/>
                    </Border>
                  </Grid>

                  <Grid Grid.Row="6">
                    <Button x:Name="btnYetkileriKaydet"
                                                Content="Kaydet"
                                                Width="180"
                                                Height="48"
                                                HorizontalAlignment="Left"
                                                Background="{StaticResource button_background_green}"
                                                Style="{StaticResource button_template}"
                                                Click="btnYetkileriKaydet_Click"/>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </Grid>

          <!-- VARSAYILAN SİSTEM AYARLARI PANELİ -->
          <Grid x:Name="panelVarsayilanSistemAyarlari" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="16"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="16"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                                   Text="Varsayılan Sistem Ayarları"
                                   Style="{StaticResource AyarBaslikStyle}"/>

            <Border Grid.Row="4"
                                Background="#222222"
                                CornerRadius="12"
                                Padding="18">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="16"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                                           Text="Sistem ayarları içeriği burada olacak."
                                           Foreground="White"
                                           FontSize="20"
                                           FontWeight="SemiBold"/>

                <Border Grid.Row="2"
                                        Background="#2B2B2B"
                                        CornerRadius="10"
                                        Padding="18"/>
              </Grid>
            </Border>
          </Grid>

          <!-- YEDEKLEME / GERİ YÜKLEME PANELİ -->
          <Grid x:Name="panelYedekleme" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="16"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="16"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                                   Text="Yedekleme / Geri Yükleme"
                                   Style="{StaticResource AyarBaslikStyle}"/>

            <TextBlock Grid.Row="2"
                                   Style="{StaticResource AyarAciklamaStyle}"
                                   Text="Bu bölümde veri yedekleme ve geri yükleme işlemleri yapılacaktır."/>

            <Border Grid.Row="4"
                                Background="#222222"
                                CornerRadius="12"
                                Padding="18">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="16"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                                           Text="Yedekleme içeriği burada olacak."
                                           Foreground="White"
                                           FontSize="20"
                                           FontWeight="SemiBold"/>

                <Border Grid.Row="2"
                                        Background="#2B2B2B"
                                        CornerRadius="10"
                                        Padding="18">
                  <TextBlock Text="Sonraki adımda yedek al, yedek seç ve geri yükle alanları eklenecek."
                                               Foreground="#D4D4D4"
                                               FontSize="17"
                                               TextWrapping="Wrap"/>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>