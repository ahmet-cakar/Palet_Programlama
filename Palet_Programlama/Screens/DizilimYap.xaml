<Page x:Class="Palet_Programlama.Screens.DizilimYap"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:Palet_Programlama.UserController"
      xmlns:language="clr-namespace:Palet_Programlama.Languages"
      mc:Ignorable="d"
      d:DesignWidth="1920"
      d:DesignHeight="1080"
      Title="Dizilim_Yap">

    <Page.Resources>
        <language:LanguageConverter x:Key="LanguageConverter"/>

        <Style x:Key="button_template" TargetType="Button">
            <Setter Property="FontFamily" Value="Roboto"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="75"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="DockPanel.Dock" Value="Bottom"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="22"
                                BorderThickness="0"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="transparan_button" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="Black"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="checkbox_siyah_aynalama" TargetType="CheckBox">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <Ellipse Stroke="White" StrokeThickness="2" Fill="Black"/>
                            <Path x:Name="CheckMark"
                                  Data="M 9,19 L 12,22 L 17,13"
                                  Margin="0,-4,0,0"
                                  Stroke="White"
                                  StrokeThickness="3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="checkbox_siyah_mod" TargetType="CheckBox">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <Ellipse Stroke="White" StrokeThickness="2" Fill="Black"/>
                            <Path x:Name="CheckMark"
                                  Data="M 9,19 L 12,22 L 17,13"
                                  Margin="0,-4,0,0"
                                  Stroke="White"
                                  StrokeThickness="3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="28,16,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <controls:UstMenu x:Name="UstMenuControl"/>
        </Grid>

        <!-- Üst bilgi alanı -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="16,10"
                    CornerRadius="16"
                    Background="#191919"
                    BorderBrush="#2B2B2B"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   x:Name="txtAynamala"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="20"
                                   Text="{Binding Source='DizilimYap.txtAynalama',Converter={StaticResource LanguageConverter}}"/>

                        <CheckBox Grid.Column="1"
                                  x:Name="cbXEkseni"
                                  Margin="10,0,0,0"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource checkbox_siyah_aynalama}"
                                  Click="cbXEkseni_Click"/>
                    </Grid>

                    <Grid Grid.Column="1" Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="20"
                                   Text="{Binding Source='DizilimYap.txtXeksen',Converter={StaticResource LanguageConverter}}"/>

                        <CheckBox Grid.Column="1"
                                  x:Name="cbYEkseni"
                                  Margin="10,0,0,0"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource checkbox_siyah_aynalama}"
                                  Click="cbYEkseni_Click"/>
                    </Grid>

                    <Grid Grid.Column="2">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="20"
                                   Text="{Binding Source='DizilimYap.txtYeksen',Converter={StaticResource LanguageConverter}}"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="16,10"
                    CornerRadius="16"
                    Background="#191919"
                    BorderBrush="#2B2B2B"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   FontSize="18"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   Text="{Binding Source='DizilimYap.urunozellik',Converter={StaticResource LanguageConverter}}"/>

                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   FontSize="18"
                                   Foreground="White"
                                   Name="txtUrunOzellikleri"
                                   Text=""
                                   TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   FontSize="18"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   Margin="0,0,8,0"
                                   Text="{Binding Source='DizilimYap.paletozellik',Converter={StaticResource LanguageConverter}}"/>

                        <TextBlock Grid.Column="1"
                                   x:Name="txtPaletOzellikleri"
                                   FontSize="18"
                                   Foreground="White"
                                   Text=""
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Ana orta alan -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.7*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="3.2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="92"/>
            </Grid.ColumnDefinitions>

            <!-- Sol taraf -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Kat kopyala -->
                <Border Grid.Row="0"
                        Padding="16,12"
                        CornerRadius="16"
                        Background="#191919"
                        BorderBrush="#2B2B2B"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Foreground="White"
                                   FontSize="20"
                                   Margin="0,0,0,8"
                                   Text="{Binding Source='DizilimYap.txtKatKopyala',Converter={StaticResource LanguageConverter}}"/>

                        <WrapPanel Grid.Row="1" VerticalAlignment="Center" ItemHeight="34">
                            <TextBlock Margin="0,0,8,0"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       Text="{Binding Source='ButtonKey.btnKopyala',Converter={StaticResource LanguageConverter}}"/>

                            <Button Width="24"
                                    Height="24"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource transparan_button}">
                                <StackPanel MouseDown="BtnKopyalaArti_MouseDown" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Image Width="18" Height="18" Source="pack://application:,,,/Images/DizilimYap/arti.png"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Width="24"
                                       Name="txtKopyalaValue"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       Foreground="White"
                                       Text="1"/>

                            <Button Width="24"
                                    Height="24"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource transparan_button}">
                                <StackPanel MouseDown="BtnKopyalaEksi_MouseDown" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Image Width="18" Height="18" Source="pack://application:,,,/Images/DizilimYap/eksi.png"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Margin="0,0,8,0"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       Text="{Binding Source='ButtonKey.btnYapistir',Converter={StaticResource LanguageConverter}}"/>

                            <Button Width="24"
                                    Height="24"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource transparan_button}">
                                <StackPanel MouseDown="BtnYapistirArti_MouseDown" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Image Width="18" Height="18" Source="pack://application:,,,/Images/DizilimYap/arti.png"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Width="24"
                                       Name="txtYapisValue"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       Foreground="White"
                                       Text="2"/>

                            <Button Width="24"
                                    Height="24"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource transparan_button}">
                                <StackPanel MouseDown="BtnYapistirEksi_MouseDown" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Image Width="18" Height="18" Source="pack://application:,,,/Images/DizilimYap/eksi.png"/>
                                </StackPanel>
                            </Button>

                            <Button Margin="8,0,0,0"
                                    Content="{Binding Source='ButtonKey.btnKopyala',Converter={StaticResource LanguageConverter}}"
                                    Width="108"
                                    Height="34"
                                    FontSize="18"
                                    Background="{StaticResource button_background}"
                                    Style="{StaticResource button_template}"
                                    Click="Btn_KatKopayala_Click"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Pozisyon seçimi -->
                <Border Grid.Row="2"
                        Padding="16"
                        CornerRadius="16"
                        Background="#191919"
                        BorderBrush="#2B2B2B"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="0.95*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Foreground="White"
                                       FontSize="18"
                                       Margin="0,0,0,10"
                                       Text="{Binding Source='DizilimYap.txtPozisyonSecimi',Converter={StaticResource LanguageConverter}}"/>

                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                <StackPanel Width="16" Height="16" VerticalAlignment="Top">
                                    <Image Width="16" Height="16" Source="pack://application:,,,/Images/DizilimYap/info-icon.png"/>
                                </StackPanel>

                                <StackPanel Orientation="Vertical" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding Source='DizilimYap.txtYazi1',Converter={StaticResource LanguageConverter}}"
                                               Foreground="White"
                                               FontSize="18"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Source='DizilimYap.txtYazi2',Converter={StaticResource LanguageConverter}}"
                                               Foreground="White"
                                               FontSize="18"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Source='DizilimYap.txtYazi3',Converter={StaticResource LanguageConverter}}"
                                               Foreground="White"
                                               FontSize="18"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Source='DizilimYap.txtDikey',Converter={StaticResource LanguageConverter}}"
                                           Width="82"
                                           Foreground="White"
                                           FontSize="16"
                                           TextAlignment="Center"/>

                                <TextBlock Text="{Binding Source='DizilimYap.txtYatay',Converter={StaticResource LanguageConverter}}"
                                           Margin="10,0,0,0"
                                           Width="82"
                                           Foreground="White"
                                           FontSize="16"
                                           TextAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,10,0,0">
                                <Rectangle Name="dikeyKutu"
                                           Width="58"
                                           Height="92"
                                           Margin="4,0,12,0"
                                           MouseDown="dikeyKutu_MouseDown"
                                           Stroke="Transparent"
                                           StrokeThickness="0">
                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="/Images/DizilimYap/dikey_kutu.png"/>
                                    </Rectangle.Fill>
                                </Rectangle>

                                <Rectangle Name="yatayKutu"
                                           Width="92"
                                           Height="58"
                                           Margin="4,14,0,0"
                                           MouseDown="yatayKutu_MouseDown"
                                           Stroke="Transparent"
                                           StrokeThickness="0">
                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="/Images/DizilimYap/yatay_kutu.png"/>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Alt sol -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="0.85*"/>
                    </Grid.ColumnDefinitions>

                    <!-- MOD -->
                    <Border Grid.Column="0"
                            Padding="16"
                            CornerRadius="16"
                            Background="#191919"
                            BorderBrush="#2B2B2B"
                            BorderThickness="1">

            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="35"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="56"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Row="0"
               Grid.Column="0"
               Name="txtCokluEklemeMod"
               VerticalAlignment="Center"
               Foreground="White"
               FontSize="20"
               Text="{Binding Source='DizilimYap.txtCokluEkleMod',Converter={StaticResource LanguageConverter}}"/>

              <CheckBox Grid.Row="0"
              Grid.Column="1"
              x:Name="cbCokluEkleme"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Style="{StaticResource checkbox_siyah_mod}"
              Click="cbCokluEkleme_Click"/>

              <TextBlock Grid.Row="2"
               Grid.Column="0"
               Name="txtHizalamaMod"
               VerticalAlignment="Center"
               Foreground="White"
               FontSize="20"
               Text="{Binding Source='DizilimYap.txtHizalamaMod',Converter={StaticResource LanguageConverter}}"/>

              <CheckBox Grid.Row="2"
              Grid.Column="1"
              x:Name="cbHizalama"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Style="{StaticResource checkbox_siyah_mod}"
              Click="cbHizalama_Click"/>

              <TextBlock Grid.Row="4"
               Grid.Column="0"
               Name="txtPaletTasimaMod"
               VerticalAlignment="Center"
               Foreground="White"
               FontSize="20"
               Text="{Binding Source='DizilimYap.txtPaletTasimaMod',Converter={StaticResource LanguageConverter}}"/>

              <CheckBox Grid.Row="4"
              Grid.Column="1"
              x:Name="cbPaletTasima"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Style="{StaticResource checkbox_siyah_mod}"
              Click="cbPaletTasima_Click"/>

              <TextBlock Grid.Row="6"
               Grid.Column="0"
               Name="txtKatTasimaMod"
               VerticalAlignment="Center"
               Foreground="White"
               FontSize="20"
               Text="{Binding Source='DizilimYap.txtKatTasimaMod',Converter={StaticResource LanguageConverter}}"/>

              <CheckBox Grid.Row="6"
              Grid.Column="1"
              x:Name="cbKatTasima"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Style="{StaticResource checkbox_siyah_mod}"
              Click="cbKatTasima_Click"/>
            </Grid>
          </Border>

                    <!-- Sağ mini kontrol -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- mm alanı -->
                        <Border Grid.Row="0"
                                Padding="10"
                                CornerRadius="16"
                                Background="#191919"
                                BorderBrush="#2B2B2B"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Width="24"
                                        Height="24"
                                        Style="{StaticResource transparan_button}">
                                    <StackPanel MouseDown="BtnHareketMiktariArti_MouseDown" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Image Width="18" Height="18" Source="pack://application:,,,/Images/DizilimYap/arti.png"/>
                                    </StackPanel>
                                </Button>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Grid.Column="1">
                                    <TextBox Width="34"
                                             Name="txtHareketMiktari"
                                             FontSize="24"
                                             VerticalAlignment="Center"
                                             Foreground="White"
                                             Text="10"
                                             TextAlignment="Center"
                                             Background="Transparent"
                                             BorderThickness="0"/>

                                    <TextBlock Margin="4,0,0,0"
                                               FontSize="24"
                                               VerticalAlignment="Center"
                                               Foreground="White"
                                               Text="mm"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Width="24"
                                        Height="24"
                                        Style="{StaticResource transparan_button}">
                                    <StackPanel MouseDown="BtnHareketMiktariEksi_MouseDown" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Image Width="18" Height="18" Source="pack://application:,,,/Images/DizilimYap/eksi.png"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- yön butonları -->
                        <Border Grid.Row="2"
                                CornerRadius="16"
                                Background="#191919"
                                BorderBrush="#2B2B2B"
                                BorderThickness="1">
                            <Viewbox Stretch="Uniform">
                                <Grid Width="170" Height="130" Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="BtnYukari" Grid.Row="0" Grid.Column="1" Width="40" Height="40" Style="{StaticResource transparan_button}" Click="BtnYukari_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Width="32" Height="32" Source="pack://application:,,,/Images/DizilimYap/yukari_ok.png"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="BtnSol" Grid.Row="1" Grid.Column="0" Width="40" Height="34" Style="{StaticResource transparan_button}" Click="BtnSol_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Width="32" Height="32" Source="pack://application:,,,/Images/DizilimYap/sola_ok.png"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="BtnSag" Grid.Row="1" Grid.Column="2" Width="40" Height="34" Style="{StaticResource transparan_button}" Click="BtnSag_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Width="32" Height="32" Source="pack://application:,,,/Images/DizilimYap/saga_ok.png"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="BtnAsagi" Grid.Row="2" Grid.Column="1" Width="40" Height="40" Style="{StaticResource transparan_button}" Click="BtnAsagi_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Image Width="32" Height="32" Source="pack://application:,,,/Images/DizilimYap/asagi_ok.png"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Viewbox>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Palet alanı -->
            <Border Grid.Column="2"
                    Padding="12"
                    CornerRadius="16"
                    Background="#191919"
                    BorderBrush="#2B2B2B"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2">
                        <StackPanel HorizontalAlignment="Left">
                            <Image Margin="10,8,0,0"
                                   MaxHeight="150"
                                   MaxWidth="150"
                                   Source="pack://application:,,,/Images/DizilimYap/referans_eksenler.png"/>
                        </StackPanel>
                    </Grid>

                    <Viewbox Grid.Column="1"
                             Grid.Row="1"
                             Stretch="Uniform"
                             StretchDirection="DownOnly"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <Canvas Name="canvasPalet"
                                Width="600"
                                Height="400"
                                MouseLeftButtonDown="canvasPalet_MouseLeftButtonDown">
                            <Canvas.Background>
                                <ImageBrush ImageSource="pack://application:,,,/Images/DizilimYap/palet.png"/>
                            </Canvas.Background>
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Border>

            <!-- Kat paneli -->
            <Border Grid.Column="4"
                    Padding="10"
                    CornerRadius="16"
                    Background="#191919"
                    BorderBrush="#2B2B2B"
                    BorderThickness="1">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="0,4,0,12"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="White"
                               FontSize="26"
                               Text="{Binding Source='DizilimYap.txtKat',Converter={StaticResource LanguageConverter}}"/>

                    <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Center">
                        <Button Margin="0,6,0,0" Style="{StaticResource transparan_button}" x:Name="AnasayfaBtn">
                            <StackPanel>
                                <Image x:Name="btnKatArti"
                                       MouseDown="btnKatArti_MouseDown"
                                       MaxHeight="54"
                                       MaxWidth="54"
                                       Source="pack://application:,,,/Images/DizilimYap/yukari_icon.png"/>
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="txtKat"
                                   Margin="0,10,0,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="White"
                                   FontSize="24"
                                   Text="1"/>

                        <Button Margin="0,10,0,0" Style="{StaticResource transparan_button}">
                            <StackPanel>
                                <Image x:Name="btnKatEksi"
                                       MouseDown="btnKatEksi_MouseDown"
                                       MaxHeight="54"
                                       MaxWidth="54"
                                       Source="pack://application:,,,/Images/DizilimYap/asagi_icon.png"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="3">
            <WrapPanel>
                <Button FontSize="15"
                        Height="38"
                        Click="Dizilimi_Kaydet_Click"
                        Content="{Binding Source='DizilimYap.btnDizilimiKaydet',Converter={StaticResource LanguageConverter}}"
                        Width="190"
                        Margin="0,0,8,0"
                        x:Name="BtnDizilimKaydet"
                        Background="{StaticResource button_background_green}"
                        Style="{StaticResource button_template}"/>

                <Button FontSize="15"
                        Height="38"
                        x:Name="BtnKatTemizle"
                        Content="{Binding Source='DizilimYap.btnKatTemizle',Converter={StaticResource LanguageConverter}}"
                        Width="190"
                        Margin="0,0,8,0"
                        Background="{StaticResource button_background}"
                        Style="{StaticResource button_template}"
                        Click="BtnKatTemizle_Click"/>

                <Button FontSize="15"
                        Height="38"
                        x:Name="BtnPaletTemizle"
                        Content="{Binding Source='DizilimYap.btnPaletTemizle',Converter={StaticResource LanguageConverter}}"
                        Width="190"
                        Margin="0,0,8,0"
                        Background="Black"
                        Style="{StaticResource button_template}"
                        Click="BtnPaletTemizle_Click"/>

                <Button FontSize="15"
                        Height="38"
                        x:Name="BtnUrunSil"
                        Content="{Binding Source='DizilimYap.btnSeciliUrunuSil',Converter={StaticResource LanguageConverter}}"
                        Width="190"
                        Margin="0,0,8,0"
                        Background="{StaticResource button_background_gray}"
                        Style="{StaticResource button_template}"
                        Click="BtnUrunSil_Click"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Page>