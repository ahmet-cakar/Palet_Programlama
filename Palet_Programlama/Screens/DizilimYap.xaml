<Page x:Class="Palet_Programlama.Screens.DizilimYap"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:Palet_Programlama.UserController"
      xmlns:language="clr-namespace:Palet_Programlama.Languages"
      mc:Ignorable="d"
      d:DesignWidth="1920"
      d:DesignHeight="1080"
      Title="Dizilim_Yap">

  <Page.Resources>
    <language:LanguageConverter x:Key="LanguageConverter"/>
  </Page.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Border VerticalAlignment="Center">
        <controls:UstMenu x:Name="UstMenuControl" />
      </Border>
    </Grid>

    <!-- Üst bilgi alanı -->
    <Grid Grid.Row="1" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.20*"/>
        <ColumnDefinition Width="1.25*"/>
      </Grid.ColumnDefinitions>

      <!-- Aynalama ve X/Y -->
      <Border Grid.Column="0"
                    Margin="0,0,10,0"
                    Padding="20,14"
                    CornerRadius="18"
                    Background="#191919">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
          </Grid.ColumnDefinitions>

          <!-- Aynalama -->
          <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                                   x:Name="txtAynamala"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="22"
                                   Text="{Binding Source='DizilimYap.txtAynalama',Converter={StaticResource LanguageConverter}}"/>

            <CheckBox Grid.Column="1"
                                  x:Name="cbXEkseni"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource checkbox_siyah_aynalama}"
                                  Click="cbXEkseni_Click"/>
          </Grid>

          <!-- X -->
          <Grid Grid.Column="1" Margin="0,0,16,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="22"
                                   Text="{Binding Source='DizilimYap.txtXeksen',Converter={StaticResource LanguageConverter}}"/>

            <CheckBox Grid.Column="1"
                                  x:Name="cbYEkseni"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource checkbox_siyah_aynalama}"
                                  Click="cbYEkseni_Click"/>
          </Grid>

          <!-- Y -->
          <Grid Grid.Column="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="22"
                                   Text="{Binding Source='DizilimYap.txtYeksen',Converter={StaticResource LanguageConverter}}"/>
          </Grid>
        </Grid>
      </Border>

      <!-- Ürün / Palet özellikleri -->
      <Border Grid.Column="1"
                    Margin="10,0,0,0"
                    Padding="20,14"
                    CornerRadius="18"
                    Background="#191919">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                                   FontSize="19"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   Text="{Binding Source='DizilimYap.urunozellik',Converter={StaticResource LanguageConverter}}"/>

            <TextBlock Grid.Column="1"
                                   Margin="10,0,0,0"
                                   FontSize="19"
                                   Foreground="White"
                                   Name="txtUrunOzellikleri"
                                   Text=""
                                   TextWrapping="Wrap"/>
          </Grid>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                                   FontSize="19"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   Margin="0,0,10,0"
                                   Text="{Binding Source='DizilimYap.paletozellik',Converter={StaticResource LanguageConverter}}"/>

            <TextBlock Grid.Column="1"
                                   x:Name="txtPaletOzellikleri"
                                   FontSize="19"
                                   Foreground="White"
                                   Text=""
                                   TextWrapping="Wrap"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- Ana orta alan -->
    <Grid Grid.Row="2" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="4.2*"/>
        <ColumnDefinition Width="3.8*"/>
        <ColumnDefinition Width="120"/>
      </Grid.ColumnDefinitions>

      <!-- Sol taraf -->
      <Grid Grid.Column="0" Margin="0,0,12,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Kat kopyala -->
        <Border Grid.Row="0"
                        Margin="0,0,0,12"
                        Padding="20,18,20,16"
                        CornerRadius="18"
                        Background="#191919">
          <StackPanel>
            <TextBlock Foreground="White"
                                   FontSize="26"
                                   Margin="0,0,0,5"
                                   Text="{Binding Source='DizilimYap.txtKatKopyala',Converter={StaticResource LanguageConverter}}"/>

            <WrapPanel VerticalAlignment="Center" ItemHeight="44">
              <TextBlock Margin="0,0,14,0"
                                       FontSize="22"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       Text="{Binding Source='ButtonKey.btnKopyala',Converter={StaticResource LanguageConverter}}"/>

              <Button Width="28"
                                    Height="28"
                                    Margin="0,0,18,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource transparan_button}">
                <StackPanel MouseDown="BtnKopyalaArti_MouseDown" Orientation="Horizontal" HorizontalAlignment="Center">
                  <Image Source="pack://application:,,,/Images/DizilimYap/arti.png"/>
                </StackPanel>
              </Button>

              <TextBlock Width="35"
                                       Name="txtKopyalaValue"
                                       VerticalAlignment="Center"
                                       FontSize="22"
                                       Foreground="White"
                                       Text="1"/>

              <Button Width="28"
                                    Height="28"
                                    Margin="0,0,18,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource transparan_button}">
                <StackPanel MouseDown="BtnKopyalaEksi_MouseDown" Orientation="Horizontal" HorizontalAlignment="Center">
                  <Image Source="pack://application:,,,/Images/DizilimYap/eksi.png"/>
                </StackPanel>
              </Button>

              <TextBlock Margin="0,0,14,0"
                                       FontSize="22"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       Text="{Binding Source='ButtonKey.btnYapistir',Converter={StaticResource LanguageConverter}}"/>

              <Button Width="28"
                                    Height="28"
                                    Margin="0,0,18,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource transparan_button}">
                <StackPanel MouseDown="BtnYapistirArti_MouseDown" Orientation="Horizontal" HorizontalAlignment="Center">
                  <Image Source="pack://application:,,,/Images/DizilimYap/arti.png"/>
                </StackPanel>
              </Button>

              <TextBlock Width="35"
                                       Name="txtYapisValue"
                                       VerticalAlignment="Center"
                                       FontSize="22"
                                       Foreground="White"
                                       Text="2"/>

              <Button Width="28"
                                    Height="28"
                                    Margin="0,0,24,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource transparan_button}">
                <StackPanel MouseDown="BtnYapistirEksi_MouseDown" Orientation="Horizontal" HorizontalAlignment="Center">
                  <Image Source="pack://application:,,,/Images/DizilimYap/eksi.png"/>
                </StackPanel>
              </Button>

              <Button Margin="20,0,0,0"
                                    Content="{Binding Source='ButtonKey.btnKopyala',Converter={StaticResource LanguageConverter}}"
                                    Width="150"
                                    Background="{StaticResource button_background}"
                                    Style="{StaticResource button_template}"
                                    Click="Btn_KatKopayala_Click"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- Pozisyon seçimi -->
        <Border Grid.Row="1"
                        Margin="0,0,0,12"
                        Padding="20"
                        CornerRadius="20"
                        Background="#191919">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.15*"/>
              <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,18,0">
              <TextBlock Foreground="White"
                                       FontSize="26"
                                       Margin="0,0,0,14"
                                       Text="{Binding Source='DizilimYap.txtPozisyonSecimi',Converter={StaticResource LanguageConverter}}"/>

              <StackPanel Margin="0,18,0,0"
                                        VerticalAlignment="Top"
                                        Orientation="Horizontal">
                <StackPanel Width="20" Height="20" VerticalAlignment="Top">
                  <Image Source="pack://application:,,,/Images/DizilimYap/info-icon.png"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="8,0,0,0">
                  <TextBlock Text="{Binding Source='DizilimYap.txtYazi1',Converter={StaticResource LanguageConverter}}"
                                               Foreground="White"
                                               FontSize="17"
                                               TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Source='DizilimYap.txtYazi2',Converter={StaticResource LanguageConverter}}"
                                               Foreground="White"
                                               FontSize="17"
                                               TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Source='DizilimYap.txtYazi3',Converter={StaticResource LanguageConverter}}"
                                               Foreground="White"
                                               FontSize="17"
                                               TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Source='DizilimYap.txtDikey',Converter={StaticResource LanguageConverter}}"
                                           Width="130"
                                           Foreground="White"
                                           FontSize="19"
                                           TextAlignment="Center"/>

                <TextBlock Text="{Binding Source='DizilimYap.txtYatay',Converter={StaticResource LanguageConverter}}"
                                           Margin="16,0,0,0"
                                           Width="130"
                                           Foreground="White"
                                           FontSize="19"
                                           TextAlignment="Center"/>
              </StackPanel>

              <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,16,0,0">
                <Rectangle Name="dikeyKutu"
                                           Width="92"
                                           Height="138"
                                           Margin="8,0,18,0"
                                           MouseDown="dikeyKutu_MouseDown"
                                           Stroke="Transparent"
                                           StrokeThickness="0">
                  <Rectangle.Fill>
                    <ImageBrush ImageSource="/Images/DizilimYap/dikey_kutu.png"/>
                  </Rectangle.Fill>
                </Rectangle>

                <Rectangle Name="yatayKutu"
                                           Width="138"
                                           Height="92"
                                           Margin="8,22,0,0"
                                           MouseDown="yatayKutu_MouseDown"
                                           Stroke="Transparent"
                                           StrokeThickness="0">
                  <Rectangle.Fill>
                    <ImageBrush ImageSource="/Images/DizilimYap/yatay_kutu.png"/>
                  </Rectangle.Fill>
                </Rectangle>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Alt sol -->
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.35*"/>
            <ColumnDefinition Width="1*"/>
          </Grid.ColumnDefinitions>

          <!-- MOD -->
          <Border Grid.Column="0"
                            Margin="0,0,12,0"
                            Padding="20"
                            CornerRadius="20"
                            Background="#191919">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel>
                <TextBlock Margin="0,8,0,0"
                                           Name="txtCokluEklemeMod"
                                           VerticalAlignment="Center"
                                           Foreground="White"
                                           FontSize="22"
                                           Text="{Binding Source='DizilimYap.txtCokluEkleMod',Converter={StaticResource LanguageConverter}}"/>

                <TextBlock VerticalAlignment="Center"
                                           Name="txtHizalamaMod"
                                           Margin="0,26,0,0"
                                           Foreground="White"
                                           FontSize="22"
                                           Text="{Binding Source='DizilimYap.txtHizalamaMod',Converter={StaticResource LanguageConverter}}"/>

                <TextBlock VerticalAlignment="Center"
                                           Name="txtPaletTasimaMod"
                                           Margin="0,26,0,0"
                                           Foreground="White"
                                           FontSize="22"
                                           Text="{Binding Source='DizilimYap.txtPaletTasimaMod',Converter={StaticResource LanguageConverter}}"/>

                <TextBlock VerticalAlignment="Center"
                                           Name="txtKatTasimaMod"
                                           Margin="0,26,0,0"
                                           Foreground="White"
                                           FontSize="22"
                                           Text="{Binding Source='DizilimYap.txtKatTasimaMod',Converter={StaticResource LanguageConverter}}"/>
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Vertical" Margin="20,4,0,0">
                <CheckBox x:Name="cbCokluEkleme" Margin="0,10,0,0" Style="{StaticResource checkbox_siyah_mod}" Click="cbCokluEkleme_Click"/>
                <CheckBox x:Name="cbHizalama" Margin="0,28,0,0" Style="{StaticResource checkbox_siyah_mod}" Click="cbHizalama_Click"/>
                <CheckBox x:Name="cbPaletTasima" Margin="0,28,0,0" Style="{StaticResource checkbox_siyah_mod}" Click="cbPaletTasima_Click"/>
                <CheckBox x:Name="cbKatTasima" Margin="0,28,0,0" Style="{StaticResource checkbox_siyah_mod}" Click="cbKatTasima_Click"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Sağ mini kontrol -->
          <Grid Grid.Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- mm alanı -->
            <Border Grid.Row="0"
                                Margin="0,0,0,12"
                                Padding="12"
                                CornerRadius="20"
                                Background="#191919">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Width="30"
                                        Height="26"
                                        Style="{StaticResource transparan_button}">
                  <StackPanel MouseDown="BtnHareketMiktariArti_MouseDown" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/Images/DizilimYap/arti.png"/>
                  </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Grid.Column="1">
                  <TextBox Width="55"
                                             Name="txtHareketMiktari"
                                             FontSize="23"
                                             VerticalAlignment="Center"
                                             Foreground="White"
                                             Text="10"
                                             TextAlignment="Center"
                                             Background="Transparent"
                                             BorderThickness="0"/>

                  <TextBlock Margin="5,0,0,0"
                                               FontSize="18"
                                               VerticalAlignment="Center"
                                               Foreground="White"
                                               Text="mm"/>
                </StackPanel>

                <Button Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Width="30"
                                        Height="26"
                                        Style="{StaticResource transparan_button}">
                  <StackPanel MouseDown="BtnHareketMiktariEksi_MouseDown" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/Images/DizilimYap/eksi.png"/>
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <!-- yön butonları -->
            <Border Grid.Row="1"
                                CornerRadius="20"
                                Background="#191919">
              <Viewbox Stretch="Uniform">
                <Grid Width="230" Height="210" Margin="18">
                  <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                  </Grid.ColumnDefinitions>

                  <Button x:Name="BtnYukari" Grid.Row="0" Grid.Column="1" Width="58" Height="58" Style="{StaticResource transparan_button}" Click="BtnYukari_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                      <Image Source="pack://application:,,,/Images/DizilimYap/yukari_ok.png"/>
                    </StackPanel>
                  </Button>

                  <Button x:Name="BtnSol" Grid.Row="1" Grid.Column="0" Width="58" Height="48" Style="{StaticResource transparan_button}" Click="BtnSol_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                      <Image Source="pack://application:,,,/Images/DizilimYap/sola_ok.png"/>
                    </StackPanel>
                  </Button>

                  <Button x:Name="BtnSag" Grid.Row="1" Grid.Column="2" Width="58" Height="48" Style="{StaticResource transparan_button}" Click="BtnSag_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                      <Image Source="pack://application:,,,/Images/DizilimYap/saga_ok.png"/>
                    </StackPanel>
                  </Button>

                  <Button x:Name="BtnAsagi" Grid.Row="2" Grid.Column="1" Width="58" Height="58" Style="{StaticResource transparan_button}" Click="BtnAsagi_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                      <Image Source="pack://application:,,,/Images/DizilimYap/asagi_ok.png"/>
                    </StackPanel>
                  </Button>
                </Grid>
              </Viewbox>
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <!-- Palet alanı -->
      <Border Grid.Column="1"
                    Margin="0,0,12,0"
                    Padding="16"
                    CornerRadius="20"
                    Background="#191919">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2">
            <StackPanel HorizontalAlignment="Left">
              <Image Margin="18,8,0,0"
                                   MaxHeight="140"
                                   MaxWidth="140"
                                   Source="pack://application:,,,/Images/DizilimYap/referans_eksenler.png"/>
            </StackPanel>
          </Grid>

          <Viewbox Grid.Column="1"
                             Grid.Row="1"
                             Stretch="Uniform"
                             StretchDirection="DownOnly"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
            <Canvas Name="canvasPalet"
                                Width="600"
                                Height="400"
                                MouseLeftButtonDown="canvasPalet_MouseLeftButtonDown">
              <Canvas.Background>
                <ImageBrush ImageSource="pack://application:,,,/Images/DizilimYap/palet.png"/>
              </Canvas.Background>
            </Canvas>
          </Viewbox>
        </Grid>
      </Border>

      <!-- Kat paneli -->
      <Border Grid.Column="2"
                    Margin="8,0,0,0"
                    Padding="12"
                    CornerRadius="20"
                    Background="#191919">
        <Grid Margin="0,16,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                               Margin="0,8,0,18"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="White"
                               FontSize="24"
                               Text="{Binding Source='DizilimYap.txtKat',Converter={StaticResource LanguageConverter}}"/>

          <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Center">
            <Button Margin="0,16,0,0" Style="{StaticResource transparan_button}" x:Name="AnasayfaBtn">
              <StackPanel>
                <Image x:Name="btnKatArti"
                                       MouseDown="btnKatArti_MouseDown"
                                       MaxHeight="46"
                                       MaxWidth="46"
                                       Source="pack://application:,,,/Images/DizilimYap/yukari_icon.png"/>
              </StackPanel>
            </Button>

            <TextBlock x:Name="txtKat"
                                   Margin="0,18,0,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="White"
                                   FontSize="28"
                                   Text="1"/>

            <Button Margin="0,18,0,0" Style="{StaticResource transparan_button}">
              <StackPanel>
                <Image x:Name="btnKatEksi"
                                       MouseDown="btnKatEksi_MouseDown"
                                       MaxHeight="46"
                                       MaxWidth="46"
                                       Source="pack://application:,,,/Images/DizilimYap/asagi_icon.png"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Footer -->
    <Grid Grid.Row="3">
      <Border CornerRadius="20"
                    Background="Transparent">
        <WrapPanel>
          <Button FontSize="22"
                            Click="Dizilimi_Kaydet_Click"
                            Content="{Binding Source='DizilimYap.btnDizilimiKaydet',Converter={StaticResource LanguageConverter}}"
                            Width="230"
                            Margin="0,0,10,10"
                            x:Name="BtnDizilimKaydet"
                            Background="{StaticResource button_background_green}"
                            Style="{StaticResource button_template}"/>

          <Button FontSize="22"
                            x:Name="BtnKatTemizle"
                            Content="{Binding Source='DizilimYap.btnKatTemizle',Converter={StaticResource LanguageConverter}}"
                            Width="230"
                            Margin="0,0,10,10"
                            Background="{StaticResource button_background}"
                            Style="{StaticResource button_template}"
                            Click="BtnKatTemizle_Click"/>

          <Button FontSize="22"
                            x:Name="BtnPaletTemizle"
                            Content="{Binding Source='DizilimYap.btnPaletTemizle',Converter={StaticResource LanguageConverter}}"
                            Width="230"
                            Margin="0,0,10,10"
                            Background="{DynamicResource button_background_black}"
                            Style="{StaticResource button_template}"
                            Click="BtnPaletTemizle_Click"/>

          <Button FontSize="22"
                            x:Name="BtnUrunSil"
                            Content="{Binding Source='DizilimYap.btnSeciliUrunuSil',Converter={StaticResource LanguageConverter}}"
                            Width="230"
                            Margin="0,0,10,10"
                            Background="{StaticResource button_background_gray}"
                            Style="{StaticResource button_template}"
                            Click="BtnUrunSil_Click"/>
        </WrapPanel>
      </Border>
    </Grid>
  </Grid>
</Page>