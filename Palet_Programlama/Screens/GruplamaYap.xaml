<Page x:Class="Palet_Programlama.Screens.GruplamaYap"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:Palet_Programlama.UserController"
      xmlns:language="clr-namespace:Palet_Programlama.Languages"
      mc:Ignorable="d"
      d:DesignWidth="1920"
      d:DesignHeight="1080"
      Title="GruplamaYap">

  <Page.Resources>
    <language:LanguageConverter x:Key="LanguageConverter"/>
  </Page.Resources>

  <Grid Margin="32,20,32,32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Border VerticalAlignment="Center">
        <controls:UstMenu x:Name="UstMenuControl" Margin="0,5,0,0"/>
      </Border>
    </Grid>

    <!-- Üst kartlar -->
    <Grid Grid.Row="1" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.07*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="1*"/>
      </Grid.ColumnDefinitions>

      <!-- Palet bilgisi -->
      <Border Grid.Column="0"
                    Padding="20,16"
                    CornerRadius="18"
                    Background="#191919"
                    BorderBrush="#2B2B2B"
                    BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Foreground="#F3F4F6"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Text="{Binding Source='GruplamaYap.txtPalet',Converter={StaticResource LanguageConverter}}"/>

          <TextBlock Grid.Column="2"
                               x:Name="txtPaletOzellikleri"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Normal"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"
                               Text="EuroPalet - 280 mm X 300 mm X 600 mm"/>
        </Grid>
      </Border>

      <!-- Gruplandırma -->
      <Border Grid.Column="2"
                    Padding="20,16"
                    CornerRadius="18"
                    Background="#191919"
                    BorderBrush="#2B2B2B"
                    BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1.4*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="White"
                                   FontSize="26"
                                   Text="{Binding Source='GruplamaYap.txtGruplandirma',Converter={StaticResource LanguageConverter}}"/>
          </StackPanel>

          <StackPanel Grid.Column="1"
                                Margin="20,0,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

            <Button x:Name="BtnGruplandirmaEksi"
                                Margin="0,0,28,0"
                                Style="{StaticResource transparan_button}"
                                Click="BtnGruplandirmaEksi_Click">
              <StackPanel>
                <Image MaxHeight="52"
                                       MaxWidth="52"
                                       Source="pack://application:,,,/Images/UserControlUstMenu/geri_icon.png"/>
              </StackPanel>
            </Button>

            <TextBlock x:Name="txtGrupValue"
                                   VerticalAlignment="Center"
                                   Margin="0,0,28,0"
                                   TextAlignment="Center"
                                   Foreground="White"
                                   FontSize="32"
                                   Text="1"
                                   Width="57"/>

            <Button x:Name="BtnGruplandirmaArti"
                                Style="{StaticResource transparan_button}"
                                Click="BtnGruplandirmaArti_Click">
              <StackPanel>
                <Image MaxHeight="52"
                                       MaxWidth="52"
                                       Source="pack://application:,,,/Images/UserControlUstMenu/ileri_icon.png"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Ana alan -->
    <Grid Grid.Row="2" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.15*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="0.95*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="92"/>
      </Grid.ColumnDefinitions>

      <!-- Sol panel -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="12"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Ürün / Dizilim / Program seçim alanı -->
        <Border Grid.Row="0"
                        Padding="22,18"
                        CornerRadius="18"
                        Background="#191919"
                        BorderBrush="#2B2B2B"
                        BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220"/>
              <ColumnDefinition Width="18"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="14"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="14"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0"
                                   Grid.Row="0"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="{Binding Source='GruplamaYap.txtUrunSecimi',Converter={StaticResource LanguageConverter}}"/>

            <ComboBox x:Name="CboxUrunListesi"
                                  Grid.Column="2"
                                  Grid.Row="0"
                                  Height="50"
                                  FontSize="20"
                                  Style="{DynamicResource theComboBox}"
                                  Background="#D4D4D4"
                                  Foreground="#575757"
                                  HorizontalContentAlignment="Left"
                                  VerticalContentAlignment="Center"
                                  Padding="8,0"
                                  ItemContainerStyle="{DynamicResource theComboBoxItem}"
                                  SelectionChanged="CboxUrunListesi_SelectionChanged"/>

            <TextBlock Grid.Column="0"
                                   Grid.Row="2"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="{Binding Source='GruplamaYap.txtDizilimSecimi',Converter={StaticResource LanguageConverter}}"/>

            <ComboBox x:Name="CboxDizilimListesi"
                                  Grid.Column="2"
                                  Grid.Row="2"
                                  Height="50"
                                  FontSize="20"
                                  Style="{DynamicResource theComboBox}"
                                  Background="#D4D4D4"
                                  Foreground="#575757"
                                  HorizontalContentAlignment="Left"
                                  VerticalContentAlignment="Center"
                                  Padding="8,0"
                                  ItemContainerStyle="{DynamicResource theComboBoxItem}"
                                  SelectionChanged="CboxDizilimListesi_SelectionChanged"/>

            <TextBlock Grid.Column="0"
                                   Grid.Row="4"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="{Binding Source='GruplamaYap.txtProgramSecimi',Converter={StaticResource LanguageConverter}}"/>

            <ComboBox x:Name="CboxProgramListesi"
                                  Grid.Column="2"
                                  Grid.Row="4"
                                  Height="50"
                                  FontSize="20"
                                  Style="{DynamicResource theComboBox}"
                                  Background="#D4D4D4"
                                  Foreground="#575757"
                                  HorizontalContentAlignment="Left"
                                  VerticalContentAlignment="Center"
                                  Padding="8,0"
                                  ItemContainerStyle="{DynamicResource theComboBoxItem}"
                                  SelectionChanged="CboxProgramListesi_SelectionChanged"/>
          </Grid>
        </Border>

        <!-- Gruplama seçimi -->
        <Border Grid.Row="2"
                        Padding="18"
                        CornerRadius="18"
                        Background="#191919"
                        BorderBrush="#2B2B2B"
                        BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2.2*"/>
              <ColumnDefinition Width="18"/>
              <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- Sol -->
            <Grid Grid.Column="0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0"
                                       Margin="0,0,0,4"
                                       Foreground="#F3F4F6"
                                       HorizontalAlignment="Center"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Text="{Binding Source='GruplamaYap.txtGruplamaSecimi',Converter={StaticResource LanguageConverter}}"/>

              <ListBox x:Name="ListBoxGruplama"
                                     Grid.Row="2"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Margin="8,0,8,0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionChanged="ListBoxGruplama_SelectionChanged">

                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel/>
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,0,12"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="ItemBorder"
                                                            Background="#222222"
                                                            BorderBrush="#303030"
                                                            BorderThickness="1"
                                                            CornerRadius="14"
                                                            Padding="18,14">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Center"/>
                          </Border>

                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="ItemBorder" Property="Background" Value="#2A2A2A"/>
                              <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3A3A3A"/>
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="ItemBorder" Property="Background" Value="#4B5563"/>
                              <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                              <Setter TargetName="ItemBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>

                      <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <TextBlock Foreground="#E5E7EB"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Source='GruplamaYap.txtKatNo', Converter={StaticResource LanguageConverter}}"/>

                        <TextBlock Margin="6,0,0,0"
                                                           Foreground="White"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Text="{Binding KatNo}"/>

                        <Border Width="1"
                                                        Height="22"
                                                        Margin="16,2"
                                                        Background="#4B5563"/>

                        <TextBlock Foreground="#E5E7EB"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Source='GruplamaYap.txtGrupNo', Converter={StaticResource LanguageConverter}}"/>

                        <TextBlock Margin="6,0,0,0"
                                                           Foreground="White"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Text="{Binding GrupNo}"/>
                      </StackPanel>

                      <CheckBox Grid.Column="1"
                                                      Margin="20,0,0,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Right"
                                                      IsEnabled="False"
                                                      IsChecked="{Binding IsaretliMi}">
                        <CheckBox.Style>
                          <Style TargetType="CheckBox">
                            <Setter Property="Template">
                              <Setter.Value>
                                <ControlTemplate TargetType="CheckBox">
                                  <Border Width="34"
                                                                            Height="34"
                                                                            CornerRadius="8"
                                                                            Background="#2A2A2A"
                                                                            BorderBrush="#4B5563"
                                                                            BorderThickness="1">
                                    <TextBlock x:Name="DurumIcon"
                                                                                   Text="✖"
                                                                                   Foreground="#EF4444"
                                                                                   FontSize="18"
                                                                                   FontWeight="Bold"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                  </Border>

                                  <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                      <Setter TargetName="DurumIcon" Property="Text" Value="✔"/>
                                      <Setter TargetName="DurumIcon" Property="Foreground" Value="#22C55E"/>
                                    </Trigger>
                                  </ControlTemplate.Triggers>
                                </ControlTemplate>
                              </Setter.Value>
                            </Setter>
                          </Style>
                        </CheckBox.Style>
                      </CheckBox>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>

            <!-- Sağ -->
            <StackPanel Grid.Column="2"
                                    VerticalAlignment="Bottom"
                                    Margin="0,8,0,0">
              <Button x:Name="BtnGrupAyarlar"
                                    FontSize="22"
                                    Height="54"
                                    Width="200"
                                    Margin="0,0,0,14"
                                    HorizontalAlignment="Stretch"
                                    Content="{Binding Source='GruplamaYap.btnAyarlar',Converter={StaticResource LanguageConverter}}"
                                    Background="{StaticResource button_background}"
                                    Style="{StaticResource button_template}"
                                    Click="BtnGrupAyarlar_Click"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- Palet alanı -->
      <Border Grid.Column="2"
                    CornerRadius="20"
                    Background="#191919"
                    BorderBrush="#2B2B2B"
                    BorderThickness="1">
        <Grid Margin="18">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Grid Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2">
            <StackPanel HorizontalAlignment="Left">
              <Image Margin="18,12,0,0"
                                   MaxHeight="150"
                                   MaxWidth="150"
                                   Source="pack://application:,,,/Images/DizilimYap/referans_eksenler.png"/>
            </StackPanel>
          </Grid>

          <Border Grid.Column="1" Grid.Row="1" Background="Transparent">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
              <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                <Canvas Name="canvasPalet"
                                        Width="600"
                                        Height="400">
                  <Canvas.Background>
                    <ImageBrush ImageSource="pack://application:,,,/Images/DizilimYap/palet.png"/>
                  </Canvas.Background>
                </Canvas>
              </Viewbox>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- Kat paneli -->
      <Border Grid.Column="4"
                    Padding="14"
                    CornerRadius="20"
                    Background="#191919"
                    BorderBrush="#2B2B2B"
                    BorderThickness="1">
        <Grid Margin="0,16,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="White"
                               FontSize="32"
                               Text="{Binding Source='DizilimYap.txtKat',Converter={StaticResource LanguageConverter}}"/>

          <StackPanel Grid.Row="1" Orientation="Vertical" VerticalAlignment="Center">
            <Button x:Name="BtnKatArti"
                                Margin="0,16,0,0"
                                Style="{StaticResource transparan_button}"
                                Click="BtnKatArti_Click">
              <StackPanel>
                <Image MaxHeight="46"
                                       MaxWidth="46"
                                       Source="pack://application:,,,/Images/DizilimYap/yukari_icon.png"/>
              </StackPanel>
            </Button>

            <TextBlock x:Name="txtKatValue"
                                   TextAlignment="Center"
                                   Margin="0,18,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="White"
                                   FontSize="28"
                                   Text="1"
                                   />

            <Button x:Name="BtnKatEksi"
                                Margin="0,18,0,0"
                                Style="{StaticResource transparan_button}"
                                Click="BtnKatEksi_Click">
              <StackPanel>
                <Image MaxHeight="46"
                                       MaxWidth="46"
                                       Source="pack://application:,,,/Images/DizilimYap/asagi_icon.png"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Footer -->
    <Grid Grid.Row="3">
      <Border CornerRadius="20" Background="Transparent">
        <WrapPanel>
          <Button x:Name="BtnProgramKaydet"
                            FontSize="22"
                            Content="{Binding Source='GruplamaYap.btnKaydet',Converter={StaticResource LanguageConverter}}"
                            Width="230"
                            Margin="0,0,10,10"
                            Background="{StaticResource button_backgroundgreen}"
                            Style="{StaticResource button_template}"
                            Click="BtnProgramKaydet_Click"/>

          <Button x:Name="BtnGruplariTemizle"
                            FontSize="22"
                            Content="{Binding Source='GruplamaYap.btnGruplariTemizle',Converter={StaticResource LanguageConverter}}"
                            Width="230"
                            Margin="0,0,10,10"
                            Background="{StaticResource button_background}"
                            Style="{StaticResource button_template}"
                            Click="BtnGruplariTemizle_Click"/>

          <Button x:Name="BtnDizilimSil"
                            FontSize="22"
                            Content="{Binding Source='GruplamaYap.btnDizilimListesi',Converter={StaticResource LanguageConverter}}"
                            Width="230"
                            Margin="0,0,10,10"
                            Background="{StaticResource button_background}"
                            Style="{StaticResource button_template}"
                            Click="BtnDizilimSil_Click"/>
        </WrapPanel>
      </Border>
    </Grid>
  </Grid>
</Page>