<Page x:Class="Palet_Programlama.Screens.HizAyarları"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:Palet_Programlama.UserController"
      xmlns:language="clr-namespace:Palet_Programlama.Languages"
      mc:Ignorable="d"
      d:DesignWidth="1920"
      d:DesignHeight="1080"
      Title="HizAyarları">

  <Page.Resources>
    <language:LanguageConverter x:Key="LanguageConverter"/>

    <Style x:Key="border_template_urunekle" TargetType="Border">
      <Setter Property="Background">
        <Setter.Value>
          <SolidColorBrush Color="Black" Opacity="0.24"/>
        </Setter.Value>
      </Setter>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="Black"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="button_template" TargetType="Button">
      <Setter Property="FontFamily" Value="Roboto"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="MinHeight" Value="46"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border CornerRadius="24"
                            BorderThickness="0"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Cursor" Value="Hand"/>
          <Setter Property="Opacity" Value="0.92"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="textblock_template_urunekle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontFamily" Value="Roboto"/>
      <Setter Property="Panel.ZIndex" Value="4"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="TextBox_templete_urunekle" TargetType="TextBox">
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="TextAlignment" Value="Left"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontFamily" Value="Roboto"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Panel.ZIndex" Value="4"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="IsHitTestVisible" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="0"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RoundedTextBoxHiz" TargetType="TextBox" BasedOn="{StaticResource TextBox_templete_urunekle}">
      <Setter Property="Width" Value="110"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#1E1E1E"/>
      <Setter Property="BorderBrush" Value="#3A3A3A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Margin" Value="12,0,0,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">
              <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="0"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <RadialGradientBrush x:Key="button_background"
                         RadiusX="0.55"
                         RadiusY="5"
                         GradientOrigin="0.5,0.5"
                         Center="0.5,0.5">
      <GradientStop Color="#F09701" Offset="0"/>
      <GradientStop Color="#FACE00" Offset="1.1"/>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="button_backgroundgreen"
                         RadiusX="0.55"
                         RadiusY="5"
                         GradientOrigin="0.5,0.5"
                         Center="0.5,0.5">
      <GradientStop Color="#0c9f04" Offset="0"/>
      <GradientStop Color="#25e432" Offset="1.1"/>
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="button_backgroundred"
                         RadiusX="0.55"
                         RadiusY="5"
                         GradientOrigin="0.5,0.5"
                         Center="0.5,0.5">
      <GradientStop Color="#b92020" Offset="0"/>
      <GradientStop Color="#ff0000" Offset="1.1"/>
    </RadialGradientBrush>
  </Page.Resources>

  <Grid Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Üst Menü -->
    <Grid Grid.Row="0" Margin="0,15,0,0">
      <controls:UstMenu x:Name="UstMenuControl"/>
    </Grid>

    <!-- Ana İçerik -->
    <Grid Grid.Row="1" Margin="40,25,40,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Sol Panel -->
      <Border Grid.Column="0"
                    Style="{StaticResource border_template_urunekle}"
                    Padding="12"
                    VerticalAlignment="Stretch">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent">
          <StackPanel Orientation="Vertical" HorizontalAlignment="Center">

            <Grid Margin="0,0,0,8" HorizontalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
               Text="{Binding Source='Hiz.v1',Converter={StaticResource LanguageConverter}}"
               Style="{StaticResource textblock_template_urunekle}"
               FontSize="20"
               VerticalAlignment="Center"/>

              <TextBox Grid.Column="2"
             Style="{StaticResource RoundedTextBoxHiz}"
             Text="% 60"
             x:Name="TxtV50"
             MaxLength="5"
             Tag="V50"
             GotFocus="HizTextBox_GotFocus"
             TextChanged="TextBox_TextChanged"
             PreviewTextInput="SadeceSayiGirisi_PreviewTextInput"
             DataObject.Pasting="SadeceSayiGirisi_Pasting"/>
            </Grid>

            <Grid Margin="0,0,0,8" HorizontalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
               Text="{Binding Source='Hiz.v2',Converter={StaticResource LanguageConverter}}"
               Style="{StaticResource textblock_template_urunekle}"
               FontSize="20"
               VerticalAlignment="Center"/>

              <TextBox Grid.Column="2"
             Style="{StaticResource RoundedTextBoxHiz}"
             Tag="V51"
             x:Name="TxtV51"
             Text="% 60"
             MaxLength="5"
             GotFocus="HizTextBox_GotFocus"
             TextChanged="TextBox_TextChanged"
             PreviewTextInput="SadeceSayiGirisi_PreviewTextInput"
             DataObject.Pasting="SadeceSayiGirisi_Pasting"/>
            </Grid>

            <Grid Margin="0,0,0,8" HorizontalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
               Text="{Binding Source='Hiz.v3',Converter={StaticResource LanguageConverter}}"
               Style="{StaticResource textblock_template_urunekle}"
               FontSize="20"
               VerticalAlignment="Center"/>

              <TextBox Grid.Column="2"
             Style="{StaticResource RoundedTextBoxHiz}"
             Text="% 40"
             Tag="V52"
             MaxLength="5"
             x:Name="TxtV52"
             GotFocus="HizTextBox_GotFocus"
             TextChanged="TextBox_TextChanged"
             PreviewTextInput="SadeceSayiGirisi_PreviewTextInput"
             DataObject.Pasting="SadeceSayiGirisi_Pasting"/>
            </Grid>

            <Grid Margin="0,0,0,8" HorizontalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
               Text="{Binding Source='Hiz.v4',Converter={StaticResource LanguageConverter}}"
               Style="{StaticResource textblock_template_urunekle}"
               FontSize="20"
               VerticalAlignment="Center"/>

              <TextBox Grid.Column="2"
             Style="{StaticResource RoundedTextBoxHiz}"
             Text="% 60"
             Tag="V53"
             MaxLength="5"
             x:Name="TxtV53"
             GotFocus="HizTextBox_GotFocus"
             TextChanged="TextBox_TextChanged"
             PreviewTextInput="SadeceSayiGirisi_PreviewTextInput"
             DataObject.Pasting="SadeceSayiGirisi_Pasting"/>
            </Grid>

            <Grid Margin="0,0,0,8" HorizontalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
               Text="{Binding Source='Hiz.v5',Converter={StaticResource LanguageConverter}}"
               Style="{StaticResource textblock_template_urunekle}"
               FontSize="20"
               VerticalAlignment="Center"/>

              <TextBox Grid.Column="2"
             Style="{StaticResource RoundedTextBoxHiz}"
             Text="% 60"
             Tag="V54"
             MaxLength="5"
             x:Name="TxtV54"
             GotFocus="HizTextBox_GotFocus"
             TextChanged="TextBox_TextChanged"
             PreviewTextInput="SadeceSayiGirisi_PreviewTextInput"
             DataObject.Pasting="SadeceSayiGirisi_Pasting"/>
            </Grid>

            <Grid Margin="0,0,0,8" HorizontalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
               Text="{Binding Source='Hiz.v6',Converter={StaticResource LanguageConverter}}"
               Style="{StaticResource textblock_template_urunekle}"
               FontSize="20"
               VerticalAlignment="Center"/>

              <TextBox Grid.Column="2"
             Style="{StaticResource RoundedTextBoxHiz}"
             Tag="V55"
             x:Name="TxtV55"
             MaxLength="5"
             Text="% 80"
             GotFocus="HizTextBox_GotFocus"
             TextChanged="TextBox_TextChanged"
             PreviewTextInput="SadeceSayiGirisi_PreviewTextInput"
             DataObject.Pasting="SadeceSayiGirisi_Pasting"/>
            </Grid>

            <Grid Margin="0,0,0,8" HorizontalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
               Text="{Binding Source='Hiz.v7',Converter={StaticResource LanguageConverter}}"
               Style="{StaticResource textblock_template_urunekle}"
               FontSize="20"
               VerticalAlignment="Center"/>

              <TextBox Grid.Column="2"
             Style="{StaticResource RoundedTextBoxHiz}"
             Tag="V56"
             x:Name="TxtV56"
             MaxLength="5"
             Text="% 80"
             GotFocus="HizTextBox_GotFocus"
             TextChanged="TextBox_TextChanged"
             PreviewTextInput="SadeceSayiGirisi_PreviewTextInput"
             DataObject.Pasting="SadeceSayiGirisi_Pasting"/>
            </Grid>

            <Grid Margin="0,0,0,8" HorizontalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
               Text="{Binding Source='Hiz.v8',Converter={StaticResource LanguageConverter}}"
               Style="{StaticResource textblock_template_urunekle}"
               FontSize="20"
               VerticalAlignment="Center"/>

              <TextBox Grid.Column="2"
             Style="{StaticResource RoundedTextBoxHiz}"
             Tag="V57"
             x:Name="TxtV57"
             MaxLength="5"
             Text="% 40"
             GotFocus="HizTextBox_GotFocus"
             TextChanged="TextBox_TextChanged"
             PreviewTextInput="SadeceSayiGirisi_PreviewTextInput"
             DataObject.Pasting="SadeceSayiGirisi_Pasting"/>
            </Grid>

            <Grid Margin="0,0,0,8" HorizontalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
               Text="{Binding Source='Hiz.v9',Converter={StaticResource LanguageConverter}}"
               Style="{StaticResource textblock_template_urunekle}"
               FontSize="20"
               VerticalAlignment="Center"/>

              <TextBox Grid.Column="2"
             Style="{StaticResource RoundedTextBoxHiz}"
             Tag="V58"
             Text="% 60"
             MaxLength="5"
             x:Name="TxtV58"
             GotFocus="HizTextBox_GotFocus"
             TextChanged="TextBox_TextChanged"
             PreviewTextInput="SadeceSayiGirisi_PreviewTextInput"
             DataObject.Pasting="SadeceSayiGirisi_Pasting"/>
            </Grid>

            <Grid Margin="0,0,0,8" HorizontalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
               Text="{Binding Source='Hiz.v10',Converter={StaticResource LanguageConverter}}"
               Style="{StaticResource textblock_template_urunekle}"
               FontSize="20"
               VerticalAlignment="Center"/>

              <TextBox Grid.Column="2"
             Style="{StaticResource RoundedTextBoxHiz}"
             Tag="V59"
             x:Name="TxtV59"
             MaxLength="5"
             Text="% 80"
             GotFocus="HizTextBox_GotFocus"
             TextChanged="TextBox_TextChanged"
             PreviewTextInput="SadeceSayiGirisi_PreviewTextInput"
             DataObject.Pasting="SadeceSayiGirisi_Pasting"/>
            </Grid>

            <Grid Margin="0,0,0,8" HorizontalAlignment="Center">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
               Text="{Binding Source='Hiz.v11',Converter={StaticResource LanguageConverter}}"
               Style="{StaticResource textblock_template_urunekle}"
               FontSize="20"
               VerticalAlignment="Center"/>

              <TextBox Grid.Column="2"
             Style="{StaticResource RoundedTextBoxHiz}"
             Tag="V60"
             Text="% 80"
             x:Name="TxtV60"
             MaxLength="5"
             GotFocus="HizTextBox_GotFocus"
             TextChanged="TextBox_TextChanged"
             PreviewTextInput="SadeceSayiGirisi_PreviewTextInput"
             DataObject.Pasting="SadeceSayiGirisi_Pasting"/>
            </Grid>

          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Sağ Panel -->
      <Border Grid.Column="2"
                    Style="{StaticResource border_template_urunekle}"
                    Padding="15"
                    VerticalAlignment="Stretch">

        <Viewbox Stretch="Uniform">
          <Grid Width="1460" Height="780">
            <Image Source="pack://application:,,,/Images/Hiz/buble_referance.png"
                               Stretch="Fill"/>

            <Canvas x:Name="OkCanvas" Background="Transparent"/>

            <Canvas IsHitTestVisible="False">
              <TextBlock Canvas.Top="220" Canvas.Left="220" Text="V_50" Foreground="White" FontSize="18"/>
              <TextBlock Canvas.Top="350" Canvas.Left="220" Text="V_51" Foreground="White" FontSize="18"/>
              <TextBlock Canvas.Top="470" Canvas.Left="300" Text="V_52" Foreground="White" FontSize="18"/>
              <TextBlock Canvas.Top="450" Canvas.Left="450" Text="V_53" Foreground="White" FontSize="18"/>
              <TextBlock Canvas.Top="330" Canvas.Left="450" Text="V_54" Foreground="White" FontSize="18"/>
              <TextBlock Canvas.Top="230" Canvas.Left="685" Text="V_55" Foreground="White" FontSize="18"/>
              <TextBlock Canvas.Top="320" Canvas.Left="940" Text="V_56" Foreground="White" FontSize="18"/>
              <TextBlock Canvas.Top="460" Canvas.Left="1010" Text="V_57" Foreground="White" FontSize="18"/>
              <TextBlock Canvas.Top="460" Canvas.Left="1150" Text="V_58" Foreground="White" FontSize="18"/>
              <TextBlock Canvas.Top="280" Canvas.Left="1150" Text="V_59" Foreground="White" FontSize="18"/>
              <TextBlock Canvas.Top="110" Canvas.Left="685" Text="V_60" Foreground="White" FontSize="18"/>
            </Canvas>
          </Grid>
        </Viewbox>
      </Border>
    </Grid>

    <!-- Alt Buton -->
    <Grid Grid.Row="2" Margin="40,20,40,30">
      <Button x:Name="BtnHizKaydet"
                    Style="{StaticResource button_template}"
                    Height="45"
                    Width="200"
                    HorizontalAlignment="Left"
                    Background="{StaticResource button_backgroundgreen}"
                    Content="{Binding Source='ButtonKey.btnKaydet',Converter={StaticResource LanguageConverter}}"
                    Click="BtnHizKaydet_Click"/>
    </Grid>
  </Grid>
</Page>