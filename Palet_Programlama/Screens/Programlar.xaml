<Page x:Class="Palet_Programlama.Sayfalar.Programlar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Palet_Programlama.Sayfalar"
      xmlns:sınıflar="clr-namespace:Palet_Programlama.Sınıflar"
      mc:Ignorable="d"
      d:DesignHeight="768"
      d:DesignWidth="1900"
      Title="Programlar">

  <Page.Resources>
    <sınıflar:LanguageConverter x:Key="LanguageConverter"/>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Üst Menü -->
    <Grid Grid.Row="0">
      <local:UstMenu x:Name="UstMenuControl" Margin="0,15,0,0"/>
    </Grid>

    <!-- Ana Alan -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- SOL TARAF -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Ürün + Palet Bilgi Kartları -->
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Ürün Bilgileri -->
          <Border Grid.Column="0"
                            Style="{StaticResource border_template_urunekle}"
                            Margin="50,30,0,0"
                            Width="440"
                            Height="300">
            <Grid Margin="20,18,20,18">
              <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="155"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Image Grid.ColumnSpan="2"
                                   Source="pack://application:,,,/Resimler/DizilimYap/info-icon.png"
                                   Width="20"
                                   Height="20"
                                   HorizontalAlignment="Right"
                                   Margin="0,-40,0,10"/>

              <TextBlock Grid.Row="0" Grid.Column="0"
                                       Margin="0,18,0,0"
                                       Style="{StaticResource textblock_template_urunekle}"
                                       Text="{Binding Source='UrunEkle.urunad',Converter={StaticResource LanguageConverter}}"/>
              <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtUrunAdi"
                                       Margin="30,18,0,0"
                                       Style="{StaticResource textblock_template_urunekle}"
                                       ToolTip="Ürün Seçilmedi"
                                       Text="Ürün Seçilmedi"/>

              <TextBlock Grid.Row="1" Grid.Column="0"
                                       Margin="0,13,0,0"
                                       Style="{StaticResource textblock_template_urunekle}"
                                       Text="{Binding Source='UrunEkle.genislik',Converter={StaticResource LanguageConverter}}"/>
              <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtUrunGenislik"
                                       Margin="30,13,0,0"
                                       Style="{StaticResource textblock_template_urunekle}"
                                       Text="-"/>

              <TextBlock Grid.Row="2" Grid.Column="0"
                                       Margin="0,13,0,0"
                                       Style="{StaticResource textblock_template_urunekle}"
                                       Text="{Binding Source='UrunEkle.uzunluk',Converter={StaticResource LanguageConverter}}"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Name="txtUrunUzunluk"
                                       Margin="30,13,0,0"
                                       Style="{StaticResource textblock_template_urunekle}"
                                       Text="-"/>

              <TextBlock Grid.Row="3" Grid.Column="0"
                                       Margin="0,13,0,0"
                                       Style="{StaticResource textblock_template_urunekle}"
                                       Text="{Binding Source='UrunEkle.yukseklik',Converter={StaticResource LanguageConverter}}"/>
              <TextBlock Grid.Row="3" Grid.Column="1" Name="txtUrunYukseklik"
                                       Margin="30,13,0,0"
                                       Style="{StaticResource textblock_template_urunekle}"
                                       Text="-"/>

              <TextBlock Grid.Row="4" Grid.Column="0"
                                       Margin="0,13,0,0"
                                       Style="{StaticResource textblock_template_urunekle}"
                                       Text="{Binding Source='UrunEkle.agirlik',Converter={StaticResource LanguageConverter}}"/>
              <TextBlock Grid.Row="4" Grid.Column="1" Name="txtUrunAgirlik"
                                       Margin="30,13,0,0"
                                       Style="{StaticResource textblock_template_urunekle}"
                                       Text="-"/>

              <TextBlock Grid.Row="5" Grid.Column="0"
                                       Margin="0,13,0,0"
                                       Style="{StaticResource textblock_template_urunekle}"
                                       Text="{Binding Source='UrunEkle.basinc',Converter={StaticResource LanguageConverter}}"/>
              <TextBlock Grid.Row="5" Grid.Column="1" Name="txtUrunBasinc"
                                       Margin="30,13,0,0"
                                       Style="{StaticResource textblock_template_urunekle}"
                                       Text="-"/>
            </Grid>
          </Border>

          <!-- Palet Bilgileri -->
          <Border Grid.Column="1"
                            Style="{StaticResource border_template_urunekle}"
                            Margin="15,30,0,0"
                            Width="440"
                            Height="300">
            <Grid Margin="20,28,20,18">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="155"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Image Grid.ColumnSpan="2"
                                   Source="pack://application:,,,/Resimler/DizilimYap/info-icon.png"
                                   Width="20"
                                   HorizontalAlignment="Right"
                                   Margin="0,-45,0,10"/>

              <TextBlock Grid.Row="0" Grid.Column="0"
                                       Margin="0,5,0,0"
                                       Style="{StaticResource textblock_template_urunekle}"
                                       Text="{Binding Source='UrunEkle.paletad',Converter={StaticResource LanguageConverter}}"/>
              <TextBlock Grid.Row="0" Grid.Column="1" 
                                       x:Name="txtPaletAdi"
                                       Margin="30,5,0,0"
                                       Style="{StaticResource textblock_template_urunekle}"
                                       Text="Palet Seçilmedi"
                                       ToolTip="Palet Seçilmedi"/>

              <TextBlock Grid.Row="1" Grid.Column="0"
                                       Margin="0,20,0,0"
                                       Style="{StaticResource textblock_template_urunekle}"
                                       Text="{Binding Source='UrunEkle.genislik',Converter={StaticResource LanguageConverter}}"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Name="txtPaletGenislik"
                                       Margin="30,20,0,0"
                                       Style="{StaticResource textblock_template_urunekle}"
                                       Text="-"/>

              <TextBlock Grid.Row="2" Grid.Column="0"
                                       Margin="0,20,0,0"
                                       Style="{StaticResource textblock_template_urunekle}"
                                       Text="{Binding Source='UrunEkle.uzunluk',Converter={StaticResource LanguageConverter}}"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Name="txtPaletUzunluk"
                                       Margin="30,20,0,0"
                                       Style="{StaticResource textblock_template_urunekle}"
                                       Text="-"/>

              <TextBlock Grid.Row="3" Grid.Column="0"
                                       Margin="0,20,0,0"
                                       Style="{StaticResource textblock_template_urunekle}"
                                       Text="{Binding Source='UrunEkle.yukseklik',Converter={StaticResource LanguageConverter}}"/>
              <TextBlock Grid.Row="3" Grid.Column="1" Name="txtPaletYukseklik"
                                       Margin="30,20,0,0"
                                       Style="{StaticResource textblock_template_urunekle}"
                                       Text="-"/>
            </Grid>
          </Border>
        </Grid>

        <!-- Program Listesi -->
        <Grid Grid.Row="1">
          <Border Style="{StaticResource border_template_urunekle}"
                            Width="900"
                            Height="480"
                            Margin="50,15,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
              </Grid.ColumnDefinitions>

              <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                                           Text="{Binding Source='Program.listtext',Converter={StaticResource LanguageConverter}}"
                                           Style="{StaticResource textblock_template_urunekle}"
                                           FontSize="25"
                                           Margin="15,5,0,30"/>

                <ListBox Grid.Row="1"
                                         x:Name="ListBoxProgramlar"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Height="400"
                                         Width="600"
                                         Padding="0,0,25,0"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         SelectionChanged="ListBoxProgramlar_SelectionChanged">

                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>

                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="Margin" Value="0,0,0,20"/>
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="Cursor" Value="Hand"/>
                      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ItemBorder"
                                                                Background="#222222"
                                                                BorderBrush="#303030"
                                                                BorderThickness="1"
                                                                CornerRadius="14"
                                                                Padding="18,14">
                              <ContentPresenter HorizontalAlignment="Stretch"
                                                                              VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3A3A3A"/>
                              </Trigger>

                              <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#4B5563"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#9CA3AF"/>
                              </Trigger>

                              <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.6"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListBox.ItemContainerStyle>

                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Foreground="White"
                                                       FontSize="19"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding ProgramAdi}"/>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>

              <Grid Grid.Column="1">
                <StackPanel VerticalAlignment="Top">


                  <Button x:Name="BtnProgramSil" FontSize="24"
                                            Width="240"
                                            Margin="0,80,0,0"
                                            Content="{Binding Source='global.btnsil',Converter={StaticResource LanguageConverter}}"
                                            Background="{StaticResource button_background}"
                                            Style="{StaticResource button_template}" Click="BtnProgramSil_Click"/>

                  <Button x:Name="BtnProgramBaslat" FontSize="24"
                                            Width="240"
                                            Margin="0,20,0,0"
                                            Content="{Binding Source='Program.btnCalistir',Converter={StaticResource LanguageConverter}}"
                                            Background="{DynamicResource button_backgroundgreen}"
                                            Style="{StaticResource button_template}" Click="BtnProgramBaslat_Click"/>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <!-- SAĞ TARAF -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Program Bilgi Alanı -->
        <Grid Grid.Row="0">
          <Border Width="930"
                            Height="100"
                            Margin="10,30,0,0"
                            CornerRadius="18"
                            Background="#191919"
                            BorderBrush="#2B2B2B"
                            BorderThickness="1"
                            Padding="28,18">

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="#E5E7EB"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Text="Program Adı ="/>

              <TextBlock Grid.Column="1"
                                       x:Name="txtProgramAdi"
                                       Margin="4,0,0,0"
                                       Text="Program Seçilmedi"
                                       ToolTip="Program Seçilmedi"
                                       VerticalAlignment="Center"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="Normal"
                                       TextTrimming="CharacterEllipsis"/>

              <Border Grid.Column="2"
                                    Width="1"
                                    Height="42"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#3F3F46"/>

              <Grid Grid.Column="3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Foreground="#E5E7EB"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Text="Program ID ="/>

                <TextBlock Grid.Column="1"
                                           x:Name="txtProgramID"
                                           VerticalAlignment="Center"
                                           Foreground="White"
                                           FontSize="20"
                                           FontWeight="Normal"
                                           Text="Seçilmedi"/>
              </Grid>
            </Grid>
          </Border>
        </Grid>

        <!-- Dizilim Gösterim -->
        <Grid Grid.Row="1">
          <Border Style="{StaticResource border_template_urunekle}"
                            Width="810"
                            Height="685"
                            Margin="10,10,0,0">
            <Grid>
              <Image Margin="25,5,0,0"
                                   MaxHeight="120"
                                   MaxWidth="120"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Source="pack://application:,,,/Resimler/DizilimYap/referans_eksenler.png"/>

              <Canvas x:Name="canvasPalet"
                                    Width="600"
                                    Height="400"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                <Canvas.Background>
                  <ImageBrush ImageSource="pack://application:,,,/Resimler/DizilimYap/palet.png"/>
                </Canvas.Background>
              </Canvas>
            </Grid>
          </Border>

          <Border Style="{StaticResource border_template_urunekle}"
                            Width="100"
                            Height="685"
                            Margin="835,10,0,0">
            <StackPanel Orientation="Vertical">
              <TextBlock Margin="0,70,0,0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="White"
                                       FontSize="30"
                                       Text="{Binding Source='DizilimYap.txtKat',Converter={StaticResource LanguageConverter}}"/>

              <Button x:Name="BtnKatArti"
                                    Margin="0,120,0,0"
                                    Style="{StaticResource transparan_button}" Click="BtnKatArti_Click">
                <Image MaxHeight="50"
                                       MaxWidth="50"
                                       Source="pack://application:,,,/Resimler/DizilimYap/yukari_icon.png"/>
              </Button>

              <TextBlock x:Name="txtKatValue" Margin="0,20,0,0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="White"
                                       FontSize="30"
                                       Text="1"/>

              <Button x:Name="BtnKatEksi" Margin="0,20,0,0"
                                    Style="{StaticResource transparan_button}" Click="BtnKatEksi_Click">
                <Image MaxHeight="50"
                                       MaxWidth="50"
                                       Source="pack://application:,,,/Resimler/DizilimYap/asagi_icon.png"/>
              </Button>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <!-- Alt Alan -->
    <Grid Grid.Row="2">
      <Border Margin="-260,25,0,0"
                    Width="1550"
                    Height="50"/>
    </Grid>
  </Grid>
</Page>