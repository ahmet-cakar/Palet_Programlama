<Window x:Class="Palet_Programlama.Popuplar.ProgramKaydetPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Program Kaydet"
        Height="260"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="8"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="20"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="Program Adı" FontWeight="SemiBold"/>
    <TextBox x:Name="TxtProgramAdi" Grid.Row="2" Height="34"/>

    <TextBlock Grid.Row="4" Text="Açıklama" FontWeight="SemiBold"/>
    <TextBox x:Name="TxtAciklama" Grid.Row="5" Height="34"/>

    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Width="100" Height="34" Margin="0,0,10,0" Content="İptal" Click="BtnIptal_Click"/>
      <Button Width="100" Height="34" Content="Kaydet" Click="BtnKaydet_Click"/>
    </StackPanel>
  </Grid>
</Window>