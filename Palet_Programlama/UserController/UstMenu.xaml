<UserControl x:Class="Palet_Programlama.UserController.UstMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Palet_Programlama.UserController"
             xmlns:language="clr-namespace:Palet_Programlama.Languages"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

  <UserControl.Resources>
    <language:LanguageConverter x:Key="LanguageConverter"/>

    <Style TargetType="Button">
      <Setter Property="Width" Value="260"/>
      <Setter Property="Foreground" Value="#d4d4d4"/>
      <Setter Property="Height" Value="35"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontWeight" Value="Regular"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontFamily" Value="Roboto"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Background="{TemplateBinding Background}" BorderThickness="0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="20*"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0">
      <Button x:Name="AnasayfaBtn"
                    Margin="0,6,0,0"
                    Style="{StaticResource transparan_button}"
                    Click="AnasayfaBtn_Click">
        <Image MaxHeight="60"
                       MaxWidth="60"
                       Source="pack://application:,,,/Images/UserControlUstMenu/geri_icon.png"/>
      </Button>
    </StackPanel>

    <StackPanel Grid.Column="1" Margin="0,6,0,0">
      <Border x:Name="MenuBorder"
                    Height="70"
                    CornerRadius="20"
                    Background="#191919">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Grid Grid.Column="0">
            <Button x:Name="BtnOnceki"
                                HorizontalAlignment="Left"
                                Style="{StaticResource ustmenu_button_style}"
                                Click="BtnOnceki_Click"/>
          </Grid>

          <Grid Grid.Column="1">
            <Button x:Name="BtnMevcut"
                                HorizontalAlignment="Left"
                                Style="{StaticResource ustmenu_button_style}"
                                IsEnabled="False"/>
          </Grid>

          <Grid Grid.Column="2">
            <Button x:Name="BtnSonraki"
                                HorizontalAlignment="Left"
                                Style="{StaticResource ustmenu_button_style}"
                                Click="BtnSonraki_Click"/>
          </Grid>
        </Grid>
      </Border>
    </StackPanel>

    <StackPanel Grid.Column="2" Margin="0,6,0,0">
      <Button x:Name="LogOutBtn"
                    Style="{StaticResource transparan_button}"
                    Click="LogOutBtn_Click">
        <Image MaxHeight="60"
                       MaxWidth="60"
                       Source="pack://application:,,,/Images/UserControlUstMenu/ana_sayfa_icon.png"/>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>